        "jsCode": "const e = $input.first().json;\nreturn [{ json: { headers: e.headers, rol_requerido: \"administrador\", datos: e.body, reglas: {\"usuario_id\": {\"tipo\": \"uuid\"}, \"rol\": {\"tipo\": \"opcion\", \"valores\": [\"instructor\", \"administrador\"]}, \"activo\": {\"tipo\": \"booleano\"}} } }];"
