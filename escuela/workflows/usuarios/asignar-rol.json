        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst e = $('Cambio permitido').first().json;\nif (r.statusCode === 404) return [{ json: { ok: false, estado: 404, cuerpo: { error: { codigo: 'NO_ENCONTRADO', mensaje: 'La cuenta no existe.' } } } }];\nif (r.statusCode !== 200 || !r.body || !r.body.id) return [{ json: { ok: false, estado: 500, cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];\nconst nombre = ((r.body.user_metadata || {}).nombre || String(r.body.email || '').split('@')[0] || 'Instructor').slice(0, 80);\nreturn [{ json: { ok: true, nombre, datos: e.datos, quien: e.usuario.id } }];"
      },
      "id": "b3b07397-d466-5897-99cc-d6487adcbbea",
      "name": "Leer cuenta",
