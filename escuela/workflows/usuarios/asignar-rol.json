          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const d = $('Leer cuenta').first().json.datos;\nreturn [{ json: { estado: 200, cuerpo: { usuario_id: d.usuario_id, rol: d.rol, activo: d.activo } } }];"
      },
