          },
          "conditions": [
            {
              "id": "80eeb742-f6cf-524d-83c2-2ef4f944a004",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
