    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT coalesce(json_agg(json_build_object('id', i.id, 'instructor', coalesce(p.nombre_publico, 'Un instructor'), 'creado_en', i.creado_en, 'expira_en', i.expira_en) ORDER BY i.creado_en DESC), '[]'::json) AS invitaciones\nFROM escuela.invitaciones_equipo i LEFT JOIN escuela.perfiles_instructor p ON p.usuario_id = i.instructor_id\nWHERE i.miembro_id = $1::uuid AND i.estado = 'pendiente' AND i.expira_en >= now();",
        "options": {
          "queryReplacement": "={{ [$json.usuario.id] }}"
        }
      },
