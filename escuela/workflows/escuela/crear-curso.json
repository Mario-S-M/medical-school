      "id": "074d4e9d-f0d0-5b7c-8e9b-6d01fd1dff56",
      "name": "Entrada valida",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1500,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH base AS (\n  SELECT coalesce(nullif(trim(both '-' from lower(regexp_replace(escuela.sin_acentos($1::text), '[^a-zA-Z0-9]+', '-', 'g'))), ''), 'curso') AS slug\n), libre AS (\n  SELECT CASE WHEN k = 1 THEN b.slug ELSE b.slug || '-' || k END AS slug\n  FROM base b, generate_series(1, 1000) k\n  WHERE NOT EXISTS (SELECT 1 FROM escuela.cursos c WHERE c.slug = CASE WHEN k = 1 THEN b.slug ELSE b.slug || '-' || k END)\n  ORDER BY k LIMIT 1\n)\nINSERT INTO escuela.cursos (slug, instructor_id, titulo) SELECT slug, $2::uuid, $1::text FROM libre\nON CONFLICT (slug) DO NOTHING RETURNING id, slug;",
        "options": {
          "queryReplacement": "={{ [$json.datos.titulo, $json.usuario.id] }}"
        }
      },
      "id": "76c1c77f-a2d6-5917-8bc7-c56a6709ae8d",
      "name": "Insertar el curso",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1800,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.id) return [{ json: { estado: 201, cuerpo: { id: Number(r.id), slug: r.slug } } }];\nreturn [{ json: { estado: 500, cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];"
      },
      "id": "cb448f33-04ea-58a5-bd99-c62d8ee48617",
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.cuerpo === null ? '' : JSON.stringify($json.cuerpo) }}",
        "options": {
          "responseCode": "={{ $json.estado }}",
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              },
