---
interface Props {
  titulo: string;
  descripcion?: string;
}
const { titulo, descripcion } = Astro.props;
---

<section class="mx-auto w-full max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <h1 class="text-2xl font-bold">{titulo}</h1>
  {descripcion && <p class="mt-1 text-sm text-slate-600">{descripcion}</p>}
  <div class="mt-6"><slot /></div>
</section>
