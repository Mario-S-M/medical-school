      "parameters": {
        "jsCode": "const e = $input.first().json;\nreturn [{ json: { headers: e.headers, rol_requerido: \"instructor\", datos: e.body, reglas: {\"titulo\": {\"tipo\": \"texto\", \"minimo\": 5, \"maximo\": 120, \"alfanumerico\": true}} } }];"
