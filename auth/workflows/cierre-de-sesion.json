      {
        "parameters": {
          "jsCode": "const entrada = $input.first().json;\nconst cabecera = String(entrada.headers['authorization'] || '');\nconst coincide = /^Bearer ([A-Za-z0-9_-]{10,2048}\\.[A-Za-z0-9_-]{10,2048}\\.[A-Za-z0-9_-]{10,2048})$/.exec(cabecera);\nif (!coincide) {\n  return [{ json: { ok: false, estado: 401,\n    cuerpo: { error: { codigo: 'TOKEN_INVALIDO', mensaje: 'El token de acceso falta, no es válido o expiró.' } } } }];\n}\nreturn [{ json: { ok: true, autorizacion: `Bearer ${coincide[1]}` } }];"
        },
