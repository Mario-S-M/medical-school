    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nreturn [{ json: { headers: e.headers, rol_requerido: \"administrador\", datos: e.body, reglas: {\"id\": {\"tipo\": \"entero\", \"minimo\": 1, \"maximo\": 32000}} } }];"
