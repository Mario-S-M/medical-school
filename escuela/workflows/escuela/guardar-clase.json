      "parameters": {
        "jsCode": "const e = $input.first().json;\nreturn [{ json: { headers: e.headers, rol_requerido: [\"instructor\", \"equipo_apoyo\"], datos: e.body, reglas: {\"seccion_id\": {\"tipo\": \"entero\", \"minimo\": 1, \"maximo\": 9007199254740}, \"clase_id\": {\"tipo\": \"entero\", \"minimo\": 1, \"maximo\": 9007199254740, \"opcional\": true}, \"titulo\": {\"tipo\": \"texto\", \"minimo\": 1, \"maximo\": 120}, \"descripcion\": {\"tipo\": \"texto\", \"opcional\": true, \"maximo\": 2000, \"multilinea\": true}, \"duracion_estimada_minutos\": {\"tipo\": \"entero\", \"opcional\": true, \"minimo\": 1, \"maximo\": 180}, \"es_muestra\": {\"tipo\": \"booleano\"}}, acceso: {\"modo\": \"dueno_o_equipo\", \"editable\": true, \"tipo\": \"seccion\", \"campo\": \"seccion_id\"} } }];"
      },
