---
import LayoutBase from '../layouts/LayoutBase.astro';
import CursosRecientes from '../componentes/catalogo/CursosRecientes';
---

<LayoutBase arriba titulo="Inicio">
  <section class="text-center">
    <h1 class="text-4xl font-bold">Bienvenido a Medical School</h1>
    <p class="mt-3 text-slate-600">Explora los cursos o crea tu cuenta para continuar.</p>
    <a href="/cursos" class="mt-5 inline-block rounded-lg bg-sky-700 px-5 py-2.5 font-medium text-white hover:bg-sky-800">Ver cursos</a>
  </section>
  <CursosRecientes client:only="react" />
</LayoutBase>
