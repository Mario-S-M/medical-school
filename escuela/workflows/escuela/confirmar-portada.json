    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH anterior AS (SELECT portada_ruta FROM escuela.cursos WHERE id = $1::bigint),\nnueva AS (UPDATE escuela.cursos SET portada_ruta = $2::text, actualizado_en = now() WHERE id = $1::bigint RETURNING id)\nSELECT (SELECT portada_ruta FROM anterior) AS anterior, EXISTS (SELECT 1 FROM nueva) AS guardada;",
        "options": {
          "queryReplacement": "={{ [$('Acceso valido').first().json.curso.id, $('Revisar ruta').first().json.ruta] }}"
        }
      },
