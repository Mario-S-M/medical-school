    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst d = e.datos;\nconst EXT = {\"image/jpeg\": \"jpg\", \"image/png\": \"png\", \"image/webp\": \"webp\"};\nconst error = (mensaje) => [{ json: { ok: false, estado: 422, cuerpo: { error: { codigo: 'PORTADA_INVALIDA', mensaje } } } }];\nif (!EXT[d.tipo_contenido]) return error('La portada debe ser una imagen JPG, PNG o WebP.');\nif (d.tamano_bytes > 2097152) return error('La portada no puede pesar más de 2 MB.');\nconst azar = Array.from({ length: 16 }, () => Math.floor(Math.random() * 256).toString(16).padStart(2, '0')).join('');\nreturn [{ json: { ok: true, ruta: `cursos/${e.curso.id}/portada-${azar}.${EXT[d.tipo_contenido]}` } }];"
      },
      "id": "aae88309-3376-5362-86de-4033154d79a5",
      "name": "Revisar portada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        0
      ]
    },
    {
      "parameters": {
