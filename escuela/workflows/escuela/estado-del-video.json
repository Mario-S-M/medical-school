    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE escuela.videos_clase SET estado = 'error', error = 'El procesamiento tardó demasiado.', actualizado_en = now() WHERE clase_id = $1::bigint AND estado IN ('en_cola', 'procesando') AND actualizado_en < now() - interval '45 minutes' RETURNING id;",
        "options": {
          "queryReplacement": "={{ [$json.datos.clase_id] }}"
        }
      },
      "id": "98c47454-33ac-5449-98d5-fffab12ee1d9",
      "name": "Cerrar vencidos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2400,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT json_build_object('id', v.id, 'estado', v.estado, 'duracion_segundos', v.duracion_segundos, 'listo_en', v.listo_en)\n   FROM escuela.videos_clase v WHERE v.clase_id = $1::bigint AND v.vigente) AS vigente,\n  (SELECT json_build_object('id', v.id, 'estado', v.estado, 'error', v.error)\n   FROM escuela.videos_clase v WHERE v.clase_id = $1::bigint AND NOT v.vigente ORDER BY v.id DESC LIMIT 1) AS nuevo;",
        "options": {
          "queryReplacement": "={{ [$('Entrada valida').first().json.datos.clase_id] }}"
        }
      },
      "id": "f0fbc17d-de16-52d6-83d8-c4850eef7b8f",
      "name": "Consultar estado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2700,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nreturn [{ json: { estado: 200, cuerpo: { vigente: r.vigente, nuevo: r.nuevo } } }];"
      },
      "id": "bc23a47d-1cf3-51e7-b0ec-a47b88ae7775",
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3000,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.cuerpo === null ? '' : JSON.stringify($json.cuerpo) }}",
        "options": {
          "responseCode": "={{ $json.estado }}",
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              },
              {
                "name": "X-Flujo",
                "value": "escuela"
              }
            ]
          }
        }
      },
      "id": "988a6864-c690-5446-9554-69b817e6d35b",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        3300,
        0
      ]
    }
