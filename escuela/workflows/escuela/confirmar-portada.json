        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst b = r.body || {};\nconst tipo = (b.content_type || (b.metadata || {}.mimetype) || '');\nconst tamano = Number(b.size || (b.metadata || {}).size || 0);\nif (r.statusCode !== 200) return [{ json: { ok: false, estado: 422, cuerpo: { error: { codigo: 'PORTADA_INVALIDA', mensaje: 'La portada todavía no se subió.' } } } }];\nif (![\"image/jpeg\", \"image/png\", \"image/webp\"].includes(tipo) || tamano > 2097152) return [{ json: { ok: false, estado: 422, cuerpo: { error: { codigo: 'PORTADA_INVALIDA', mensaje: 'La portada debe ser una imagen JPG, PNG o WebP de hasta 2 MB.' } } } }];\nreturn [{ json: { ok: true } }];"
      },
      "id": "a6911887-f070-5f27-94f1-f2ac6fb08102",
      "name": "Clasificar archivo",
