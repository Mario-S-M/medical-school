          },
          "options": {}
        },
        "id": "a0000006-0000-4000-8000-000000000003",
        "name": "Solicitud valida",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          480,
          0
        ]
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH limpieza AS (\n  DELETE FROM autenticacion.eventos_codigo WHERE creado_en < now() - interval '1 day'\n),\npor_correo AS (\n  SELECT count(*) AS n, min(creado_en) AS primero\n  FROM autenticacion.eventos_codigo\n  WHERE correo = $1 AND proposito = $3 AND tipo = 'solicitud' AND creado_en > now() - interval '1 hour'\n),\npor_ip AS (\n  SELECT count(*) AS n, min(creado_en) AS primero\n  FROM autenticacion.eventos_codigo\n  WHERE ip = $2::inet AND tipo = 'solicitud' AND creado_en > now() - interval '1 hour'\n)\nSELECT pc.n AS solicitudes_correo,\n       GREATEST(1, CEIL(EXTRACT(EPOCH FROM (pc.primero + interval '1 hour' - now()))))::int AS reintentar_correo,\n       pi.n AS solicitudes_ip,\n       GREATEST(1, CEIL(EXTRACT(EPOCH FROM (pi.primero + interval '1 hour' - now()))))::int AS reintentar_ip\nFROM por_correo pc, por_ip pi;",
          "options": {
            "queryReplacement": "={{ [$json.correo, $json.ip, 'recuperacion'] }}"
          }
        },
        "id": "a0000006-0000-4000-8000-000000000004",
        "name": "Consultar limites",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.5,
        "position": [
          720,
          -150
        ],
        "credentials": {
          "postgres": {
            "id": "pgSupabase01",
            "name": "Postgres n8n (Supabase)"
          }
        },
        "onError": "continueRegularOutput",
        "alwaysOutputData": true
      },
      {
        "parameters": {
          "jsCode": "const c = $input.first().json;\nif (c.error || c.solicitudes_correo === undefined) {\n  return [{ json: { ruta: 'error', estado: 500, cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];\n}\nconst bloqueo = (segundos) => ({ json: { ruta: 'bloqueo', estado: 429, retry_after: segundos, cuerpo: { error: {\n  codigo: 'DEMASIADOS_INTENTOS', mensaje: 'Demasiadas solicitudes de código. Inténtalo de nuevo más tarde.', reintentar_en_segundos: segundos } } } });\nif (Number(c.solicitudes_correo) >= 3) return [bloqueo(Number(c.reintentar_correo))];\nif (Number(c.solicitudes_ip) >= 10) return [bloqueo(Number(c.reintentar_ip))];\nreturn [{ json: { ruta: 'continuar' } }];"
        },
