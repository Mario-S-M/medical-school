    {
      "parameters": {
        "jsCode": "const r = $('Borrar videos de la clase').first().json;\nif (r.cantidad > 0) return [{ json: { estado: 204, cuerpo: null } }];\nreturn [{ json: { estado: 404, cuerpo: { error: { codigo: 'NO_ENCONTRADO', mensaje: 'El video no existe en este curso.' } } } }];"
      },
