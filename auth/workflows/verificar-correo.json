      {
        "parameters": {
          "jsCode": "const r = $input.first().json;\nconst estado = r.statusCode;\nconst gt = r.body && typeof r.body === 'object' ? r.body : {};\nif (estado === 200) {\n  // Supabase devuelve una sesión al verificar: se descarta (nunca llega al cliente) y se revoca\n  return [{ json: { resultado: 'ok', autorizacion: gt.access_token ? `Bearer ${gt.access_token}` : '' } }];\n}\nif ([400, 401, 403, 404, 410, 422].includes(estado)) {\n  return [{ json: { resultado: 'codigo_invalido', estado: 400, cuerpo: { error: { codigo: 'CODIGO_INVALIDO', mensaje: 'El código no es válido o expiró.' } } } }];\n}\nif (estado === 429) {\n  return [{ json: { resultado: 'error', estado: 429, cuerpo: { error: { codigo: 'DEMASIADOS_INTENTOS', mensaje: 'Demasiadas solicitudes. Inténtalo más tarde.' } } } }];\n}\nreturn [{ json: { resultado: 'error', estado: 500, cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];"
        },
