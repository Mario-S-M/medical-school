          "name": "Secreto proxy"
        }
      },
      "webhookId": "be32dbfb-f3a5-56d1-bf69-08be20820f6e"
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nreturn [{ json: { headers: e.headers, rol_requerido: \"administrador\", datos: e.body, reglas: {\"curso_id\": {\"tipo\": \"entero\", \"minimo\": 1, \"maximo\": 9007199254740}, \"comentario\": {\"tipo\": \"texto\", \"minimo\": 1, \"maximo\": 1000, \"multilinea\": true}} } }];"
      },
