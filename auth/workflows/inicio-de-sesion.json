      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH limpieza AS (\n  DELETE FROM autenticacion.intentos_inicio_sesion WHERE creado_en < now() - interval '1 day'\n),\nultimo AS (\n  SELECT coalesce(max(creado_en), '-infinity'::timestamptz) AS desde\n  FROM autenticacion.intentos_inicio_sesion WHERE correo = $1 AND exitoso\n),\nfallos_correo AS (\n  SELECT count(*) AS n, min(i.creado_en) AS primero\n  FROM autenticacion.intentos_inicio_sesion i, ultimo u\n  WHERE i.correo = $1 AND NOT i.exitoso AND i.creado_en > now() - interval '15 minutes' AND i.creado_en > u.desde\n),\nfallos_ip AS (\n  SELECT count(*) AS n, min(creado_en) AS primero\n  FROM autenticacion.intentos_inicio_sesion\n  WHERE ip = $2::inet AND NOT exitoso AND creado_en > now() - interval '15 minutes'\n)\nSELECT fc.n AS fallos_correo,\n       GREATEST(1, CEIL(EXTRACT(EPOCH FROM (fc.primero + interval '15 minutes' - now()))))::int AS reintentar_correo,\n       fi.n AS fallos_ip,\n       GREATEST(1, CEIL(EXTRACT(EPOCH FROM (fi.primero + interval '15 minutes' - now()))))::int AS reintentar_ip\nFROM fallos_correo fc, fallos_ip fi;",
          "options": {
            "queryReplacement": "={{ [$json.correo, $json.ip] }}"
          }
        },
        "id": "a0000002-0000-4000-8000-000000000004",
        "name": "Consultar bloqueos",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.5,
        "position": [
          720,
          -150
        ],
        "credentials": {
          "postgres": {
            "id": "pgSupabase01",
            "name": "Postgres n8n (Supabase)"
          }
        },
        "onError": "continueRegularOutput",
        "alwaysOutputData": true
      },
      {
        "parameters": {
          "jsCode": "const c = $input.first().json;\nconst errorInterno = { json: { ruta: 'error', estado: 500, cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } };\nif (c.error || c.fallos_correo === undefined) return [errorInterno];\nif (Number(c.fallos_correo) >= 5) {\n  const segundos = Number(c.reintentar_correo);\n  return [{ json: { ruta: 'bloqueo', estado: 429, retry_after: segundos, cuerpo: { error: {\n    codigo: 'CUENTA_BLOQUEADA', mensaje: 'Demasiados intentos fallidos. Inténtalo de nuevo más tarde.', reintentar_en_segundos: segundos } } } }];\n}\nif (Number(c.fallos_ip) >= 20) {\n  const segundos = Number(c.reintentar_ip);\n  return [{ json: { ruta: 'bloqueo', estado: 429, retry_after: segundos, cuerpo: { error: {\n    codigo: 'DEMASIADOS_INTENTOS', mensaje: 'Demasiados intentos desde tu conexión. Inténtalo de nuevo más tarde.', reintentar_en_segundos: segundos } } } }];\n}\nreturn [{ json: { ruta: 'continuar' } }];"
        },
