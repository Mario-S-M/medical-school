    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH nueva AS (\n  INSERT INTO escuela.clases (seccion_id, titulo, descripcion, duracion_estimada_minutos, es_muestra, posicion)\n  SELECT $1::bigint, $3::text, $4::text, $5::int, $6::boolean, coalesce((SELECT max(posicion) FROM escuela.clases WHERE seccion_id = $1::bigint), 0) + 1\n  WHERE $2::bigint IS NULL RETURNING id\n), editada AS (\n  UPDATE escuela.clases SET titulo = $3::text, descripcion = $4::text, duracion_estimada_minutos = $5::int, es_muestra = $6::boolean\n  WHERE id = $2::bigint AND seccion_id = $1::bigint RETURNING id\n)\nSELECT coalesce((SELECT id FROM nueva), (SELECT id FROM editada)) AS id;",
        "options": {
          "queryReplacement": "={{ [$json.datos.seccion_id, $json.datos.clase_id, $json.datos.titulo, $json.datos.descripcion, $json.datos.duracion_estimada_minutos, $json.datos.es_muestra] }}"
        }
      },
