      "id": "4677012c-770e-578e-bb7b-540dfa482b00",
      "name": "Entrada valida",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1500,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH c AS (SELECT id, estado FROM escuela.cursos WHERE id = $1::bigint),\npermitido AS (SELECT (SELECT estado FROM c) = 'en_revision' AND ($2::boolean OR $3::text IS NOT NULL) AS v),\nresuelto AS (\n  UPDATE escuela.cursos SET\n    estado = CASE WHEN $2::boolean THEN 'publicado' ELSE 'borrador' END,\n    comentario_revision = CASE WHEN $2::boolean THEN NULL ELSE $3::text END,\n    publicado_en = CASE WHEN $2::boolean THEN now() ELSE publicado_en END,\n    actualizado_en = now()\n  WHERE id = $1::bigint AND (SELECT v FROM permitido) RETURNING id\n)\nSELECT CASE WHEN NOT EXISTS (SELECT 1 FROM c) THEN 'no_encontrado'\n            WHEN (SELECT estado FROM c) <> 'en_revision' THEN 'estado_invalido'\n            WHEN NOT (SELECT v FROM permitido) THEN 'falta_comentario' ELSE 'ok' END AS resultado;",
        "options": {
          "queryReplacement": "={{ [$json.datos.curso_id, $json.datos.aprobar, $json.datos.comentario] }}"
        }
      },
      "id": "b728065e-c196-5de7-ad0c-61888c599b70",
      "name": "Aplicar la decision",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1800,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst aprobar = $('Entrada valida').first().json.datos.aprobar;\nconst error = (estado, codigo, mensaje, detalles) => [{ json: { estado, cuerpo: { error: { codigo, mensaje, ...(detalles ? { detalles } : {}) } } } }];\nif (r.resultado === 'ok') return [{ json: { estado: 200, cuerpo: { estado: aprobar ? 'publicado' : 'borrador' } } }];\nif (r.resultado === 'no_encontrado') return error(404, 'NO_ENCONTRADO', 'El curso no existe.');\nif (r.resultado === 'estado_invalido') return error(409, 'ESTADO_INVALIDO', 'Solo se pueden resolver cursos que están en revisión.');\nif (r.resultado === 'falta_comentario') return error(422, 'VALIDACION_FALLIDA', 'Revisa los datos enviados.', [{ campo: 'comentario', regla: 'obligatorio_si_se_devuelve', mensaje: 'Explica al instructor qué debe cambiar.' }]);\nreturn error(500, 'ERROR_INTERNO', 'Error interno del servidor.');"
      },
      "id": "584de012-e4f3-530e-9b5b-14844c427af7",
