          },
          "conditions": [
            {
              "id": "62ccad87-14b5-5a0c-bf08-d130fe85b532",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
