      "id": "7ef7bdfd-30d1-578f-9e5c-413cfdeb89c5",
      "name": "Entrada valida",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1500,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH borrada AS (\n  DELETE FROM escuela.categorias WHERE id = $1::int AND NOT EXISTS (SELECT 1 FROM escuela.cursos WHERE categoria_id = $1::int) RETURNING id\n)\nSELECT CASE\n  WHEN EXISTS (SELECT 1 FROM borrada) THEN 'ok'\n  WHEN NOT EXISTS (SELECT 1 FROM escuela.categorias WHERE id = $1::int) THEN 'no_encontrada'\n  ELSE 'en_uso' END AS resultado;",
        "options": {
          "queryReplacement": "={{ [$json.datos.id] }}"
        }
      },
      "id": "a0e06b48-78cd-55cb-a4a2-7f36d21d192e",
      "name": "Borrar en la base",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1800,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.resultado === 'ok') return [{ json: { estado: 204, cuerpo: null } }];\nif (r.resultado === 'no_encontrada') return [{ json: { estado: 404, cuerpo: { error: { codigo: 'NO_ENCONTRADO', mensaje: 'La categoría no existe.' } } } }];\nif (r.resultado === 'en_uso') return [{ json: { estado: 409, cuerpo: { error: { codigo: 'CATEGORIA_EN_USO', mensaje: 'La categoría tiene cursos asignados.' } } } }];\nreturn [{ json: { estado: 500, cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];"
      },
      "id": "f2d954a5-078a-51b0-afac-bc28c018c526",
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.cuerpo === null ? '' : JSON.stringify($json.cuerpo) }}",
        "options": {
          "responseCode": "={{ $json.estado }}",
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              },
              {
                "name": "X-Flujo",
                "value": "escuela"
              }
            ]
          }
        }
      },
      "id": "1a1f648f-1f0e-5314-a9ea-82ffb0fcd6b3",
      "name": "Responder",
