          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { estado: 200, cuerpo: { categorias: $input.first().json.categorias } } }];"
