    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nreturn [{ json: { headers: e.headers, rol_requerido: \"administrador\", datos: e.body, reglas: {\"curso_id\": {\"tipo\": \"entero\", \"minimo\": 1, \"maximo\": 9007199254740}, \"aprobar\": {\"tipo\": \"booleano\"}, \"comentario\": {\"tipo\": \"texto\", \"opcional\": true, \"maximo\": 1000, \"multilinea\": true}} } }];"
      },
