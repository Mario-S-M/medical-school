                "value": "application/json; charset=utf-8"
              },
              {
                "name": "X-Flujo",
                "value": "escuela"
              }
            ]
          }
        }
      },
      "id": "6aaef206-e423-5852-9675-a017b7ce799c",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
