    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.id) return [{ json: { estado: 200, cuerpo: { id: Number(r.id) } } }];\nreturn [{ json: { estado: 404, cuerpo: { error: { codigo: 'NO_ENCONTRADO', mensaje: 'La sección no existe en este curso.' } } } }];"
      },
      "id": "755aab97-8edf-5d5b-930c-943eda6d50ab",
