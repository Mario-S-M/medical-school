          "name": "Secreto proxy"
        }
      },
      "webhookId": "8bc058be-ad62-5702-87d3-c597fbb4d24c"
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nreturn [{ json: { headers: e.headers, rol_requerido: \"instructor\", datos: e.body, reglas: {\"miembro_id\": {\"tipo\": \"uuid\"}} } }];"
      },
