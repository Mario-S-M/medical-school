    {
      "parameters": {
        "method": "GET",
        "url": "=http://auth:9999/admin/users?filter={{ encodeURIComponent($json.datos.correo) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "32c4943f-11de-5787-a7e7-471f655b54f9",
      "name": "Consultar Supabase Auth",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        0
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabaseServicio01",
          "name": "Supabase rol de servicio"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst correo = $('Entrada valida').first().json.datos.correo;\nif (r.statusCode !== 200 || !r.body || !Array.isArray(r.body.users)) return [{ json: { ok: false, estado: 500, cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];\nconst u = r.body.users.find((x) => String(x.email || '').toLowerCase() === correo);\nif (!u) return [{ json: { ok: false, estado: 404, cuerpo: { error: { codigo: 'NO_ENCONTRADO', mensaje: 'No hay ninguna cuenta con ese correo.' } } } }];\nreturn [{ json: { ok: true, id: u.id, correo: u.email, nombre: (u.user_metadata || {}).nombre ?? null, verificado: !!u.email_confirmed_at } }];"
      },
      "id": "be4d4c5e-cc54-5510-91fd-0a85ed160ac2",
      "name": "Elegir coincidencia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "8143fdcf-dfc1-54ba-b338-dea01fae3b2f",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "98c8c891-2623-5c19-ba00-807ed8980e21",
      "name": "Cuenta encontrada",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2400,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT coalesce(array_agg(rol ORDER BY rol), '{}') AS roles FROM escuela.roles_usuario WHERE usuario_id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ [$json.id] }}"
        }
      },
      "id": "bb9a27fa-94f2-5d59-8aaf-ded7e7cff58a",
      "name": "Consultar roles",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2700,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const u = $('Elegir coincidencia').first().json;\nreturn [{ json: { estado: 200, cuerpo: { id: u.id, correo: u.correo, nombre: u.nombre, verificado: u.verificado, roles: $input.first().json.roles } } }];"
      },
      "id": "b4296d4e-e10b-5426-9c13-7b30a82ac048",
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3000,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.cuerpo === null ? '' : JSON.stringify($json.cuerpo) }}",
        "options": {
          "responseCode": "={{ $json.estado }}",
          "responseHeaders": {
