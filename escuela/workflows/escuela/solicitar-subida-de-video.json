    {
      "parameters": {
        "jsCode": "const d = $input.first().json.datos;\nconst EXT = {\"video/mp4\": \"mp4\", \"video/quicktime\": \"mov\", \"video/webm\": \"webm\"};\nconst error = (mensaje) => [{ json: { ok: false, estado: 422, cuerpo: { error: { codigo: 'VIDEO_INVALIDO', mensaje } } } }];\nif (!EXT[d.tipo_contenido]) return error('El video debe ser MP4, MOV o WebM.');\nif (d.tamano_bytes > 1073741824) return error('El video no puede pesar más de 1 GiB.');\nreturn [{ json: { ok: true, extension: EXT[d.tipo_contenido] } }];"
      },
      "id": "027606bd-8199-5c76-9476-cb6271af553f",
      "name": "Revisar video",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
