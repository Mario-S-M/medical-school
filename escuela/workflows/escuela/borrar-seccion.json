    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH rutas AS (\n  SELECT coalesce(array_agg(v.ruta_base), '{}') AS rutas FROM escuela.videos_clase v JOIN escuela.clases k ON k.id = v.clase_id WHERE k.seccion_id = $1::bigint\n), borrada AS (\n  DELETE FROM escuela.secciones WHERE id = $1::bigint RETURNING curso_id\n), renumeradas AS (\n  UPDATE escuela.secciones s SET posicion = n.nueva\n  FROM (SELECT id, row_number() OVER (ORDER BY posicion) AS nueva FROM escuela.secciones\n        WHERE curso_id = (SELECT curso_id FROM borrada) AND id <> $1::bigint) n\n  WHERE s.id = n.id RETURNING s.id\n)\nSELECT EXISTS (SELECT 1 FROM borrada) AS borrada, (SELECT rutas FROM rutas) AS rutas_base;",
        "options": {
          "queryReplacement": "={{ [$json.datos.seccion_id] }}"
        }
      },
      "id": "29e8a473-dcf2-5038-9b9d-90bb7762a4c3",
      "name": "Borrar y renumerar",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2400,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nreturn [{ json: { rutas_base: r.borrada ? (r.rutas_base || []) : [] } }];"
      },
