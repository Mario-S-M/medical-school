    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nreturn [{ json: { headers: e.headers, rol_requerido: [\"instructor\", \"equipo_apoyo\"], datos: e.body, reglas: {\"tipo\": {\"tipo\": \"opcion\", \"valores\": [\"seccion\", \"clase\"]}, \"id\": {\"tipo\": \"entero\", \"minimo\": 1, \"maximo\": 9007199254740}, \"direccion\": {\"tipo\": \"opcion\", \"valores\": [\"subir\", \"bajar\"]}}, acceso: {\"modo\": \"dueno_o_equipo\", \"editable\": true, \"tipo\": \"dato\", \"campo\": \"id\"} } }];"
      },
