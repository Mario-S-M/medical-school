    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nreturn [{ json: { headers: e.headers, rol_requerido: \"administrador\", datos: e.body, reglas: {\"id\": {\"tipo\": \"entero\", \"opcional\": true, \"minimo\": 1, \"maximo\": 32000}, \"nombre\": {\"tipo\": \"texto\", \"minimo\": 2, \"maximo\": 60, \"alfanumerico\": true}, \"posicion\": {\"tipo\": \"entero\", \"minimo\": 1, \"maximo\": 1000}} } }];"
      },
      "id": "8212b9a3-3370-54f8-aa13-014fd4a01e08",
      "name": "Definir reglas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
