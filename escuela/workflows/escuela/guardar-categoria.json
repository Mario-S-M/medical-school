    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "e36e849b-fc3f-5976-be03-3f84351f122b",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2b60a500-1422-566f-b68a-bd41d720b65d",
      "name": "Entrada valida",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1500,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH datos AS (\n  SELECT $1::int AS id, $2::text AS nombre, $3::int AS posicion,\n         trim(both '-' from lower(regexp_replace(escuela.sin_acentos($2::text), '[^a-zA-Z0-9]+', '-', 'g'))) AS slug\n), actualizada AS (\n  UPDATE escuela.categorias c SET nombre = d.nombre, slug = d.slug, posicion = d.posicion FROM datos d\n  WHERE c.id = d.id AND NOT EXISTS (SELECT 1 FROM escuela.categorias o WHERE o.id <> d.id AND (o.nombre = d.nombre OR o.slug = d.slug))\n  RETURNING c.id\n), insertada AS (\n  INSERT INTO escuela.categorias (nombre, slug, posicion)\n  SELECT nombre, slug, posicion FROM datos d\n  WHERE d.id IS NULL AND NOT EXISTS (SELECT 1 FROM escuela.categorias o WHERE o.nombre = d.nombre OR o.slug = d.slug)\n  RETURNING id\n)\nSELECT CASE\n  WHEN EXISTS (SELECT 1 FROM actualizada) OR EXISTS (SELECT 1 FROM insertada) THEN 'ok'\n  WHEN (SELECT id FROM datos) IS NOT NULL AND NOT EXISTS (SELECT 1 FROM escuela.categorias WHERE id = (SELECT id FROM datos)) THEN 'no_encontrada'\n  ELSE 'duplicada' END AS resultado,\n  coalesce((SELECT id FROM actualizada), (SELECT id FROM insertada)) AS id;",
        "options": {
          "queryReplacement": "={{ [$json.datos.id, $json.datos.nombre, $json.datos.posicion] }}"
        }
      },
      "id": "3155b8ab-249b-5979-987a-6a22cb834f8e",
      "name": "Guardar en la base",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1800,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.resultado === 'ok') return [{ json: { estado: 200, cuerpo: { id: r.id } } }];\nif (r.resultado === 'no_encontrada') return [{ json: { estado: 404, cuerpo: { error: { codigo: 'NO_ENCONTRADO', mensaje: 'La categoría no existe.' } } } }];\nif (r.resultado === 'duplicada') return [{ json: { estado: 409, cuerpo: { error: { codigo: 'CATEGORIA_DUPLICADA', mensaje: 'Ya existe una categoría con ese nombre.' } } } }];\nreturn [{ json: { estado: 500, cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];"
      },
      "id": "0fee159e-7d56-51f2-94e3-5b4e821fb38b",
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.cuerpo === null ? '' : JSON.stringify($json.cuerpo) }}",
        "options": {
          "responseCode": "={{ $json.estado }}",
          "responseHeaders": {
