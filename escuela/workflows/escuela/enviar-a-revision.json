    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nreturn [{ json: { headers: e.headers, rol_requerido: \"instructor\", datos: e.body, reglas: {\"curso_id\": {\"tipo\": \"entero\", \"minimo\": 1, \"maximo\": 9007199254740}}, acceso: {\"modo\": \"dueno\", \"editable\": true, \"tipo\": \"curso\", \"campo\": \"curso_id\"} } }];"
      },
