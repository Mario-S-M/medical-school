      },
      "id": "0de78d00-bd01-56e8-a6fb-b473bafbdb31",
      "name": "Portada valida",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2700,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://storage:5000/object/upload/sign/portadas/{{ $json.ruta }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "71fe23df-a6bf-5037-ad14-de0206e320cf",
      "name": "Firmar subida en Storage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3000,
        0
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabaseServicio01",
          "name": "Supabase rol de servicio"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst ruta = $('Revisar portada').first().json.ruta;\nif (r.statusCode === 200 && r.body && r.body.url) return [{ json: { estado: 200, cuerpo: { url_subida: `/almacen${r.body.url}`, ruta } } }];\nreturn [{ json: { estado: 500, cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];"
      },
      "id": "e31a6a5d-7a6f-5c9a-8598-c5cb2bb920a9",
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
