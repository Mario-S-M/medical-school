    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nreturn [{ json: { headers: e.headers, rol_requerido: [\"instructor\", \"equipo_apoyo\"], datos: e.body, reglas: {\"clase_id\": {\"tipo\": \"entero\", \"minimo\": 1, \"maximo\": 9007199254740}, \"nombre_archivo\": {\"tipo\": \"texto\", \"minimo\": 1, \"maximo\": 255}, \"tipo_contenido\": {\"tipo\": \"texto\", \"minimo\": 1, \"maximo\": 100}, \"tamano_bytes\": {\"tipo\": \"entero\", \"minimo\": 1, \"maximo\": 1000000000000}}, acceso: {\"modo\": \"dueno_o_equipo\", \"editable\": true, \"tipo\": \"clase\", \"campo\": \"clase_id\"} } }];"
