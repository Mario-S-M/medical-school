    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH borrada AS (\n  DELETE FROM escuela.clases WHERE id = $1::bigint RETURNING seccion_id\n), renumeradas AS (\n  UPDATE escuela.clases k SET posicion = n.nueva\n  FROM (SELECT id, row_number() OVER (ORDER BY posicion) AS nueva FROM escuela.clases\n        WHERE seccion_id = (SELECT seccion_id FROM borrada) AND id <> $1::bigint) n\n  WHERE k.id = n.id RETURNING k.id\n)\nSELECT EXISTS (SELECT 1 FROM borrada) AS borrada;",
        "options": {
          "queryReplacement": "={{ [$json.datos.clase_id] }}"
        }
      },
      "id": "e1139cc4-5041-5df1-8bc1-5ae544f88a1f",
      "name": "Borrar y renumerar",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2400,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.borrada) return [{ json: { estado: 204, cuerpo: null } }];\nreturn [{ json: { estado: 404, cuerpo: { error: { codigo: 'NO_ENCONTRADO', mensaje: 'La clase no existe en este curso.' } } } }];"
      },
      "id": "2e0434a3-5e5e-57a7-9669-ea9816ef94a7",
      "name": "Armar respuesta",
