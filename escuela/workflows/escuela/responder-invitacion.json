      "id": "b9fea952-8efd-5809-a959-d3aa1937aced",
      "name": "Entrada valida",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1500,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH inv AS (SELECT * FROM escuela.invitaciones_equipo WHERE id = $1::bigint AND miembro_id = $2::uuid AND estado = 'pendiente' AND expira_en >= now()),\nresp AS (\n  UPDATE escuela.invitaciones_equipo SET estado = CASE WHEN $3::boolean THEN 'aceptada' ELSE 'rechazada' END, respondida_en = now()\n  WHERE id IN (SELECT id FROM inv) RETURNING id\n), equipo AS (\n  INSERT INTO escuela.equipos_apoyo (instructor_id, miembro_id) SELECT instructor_id, miembro_id FROM inv WHERE $3::boolean ON CONFLICT DO NOTHING RETURNING 1\n), rol AS (\n  INSERT INTO escuela.roles_usuario (usuario_id, rol) SELECT miembro_id, 'equipo_apoyo' FROM inv WHERE $3::boolean ON CONFLICT DO NOTHING RETURNING 1\n)\nSELECT EXISTS (SELECT 1 FROM resp) AS respondida;",
        "options": {
          "queryReplacement": "={{ [$json.datos.invitacion_id, $json.usuario.id, $json.datos.aceptar] }}"
        }
      },
      "id": "d1189983-7d8d-5bc7-8581-82c27aefaaf5",
      "name": "Aplicar la respuesta",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1800,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.respondida) return [{ json: { estado: 200, cuerpo: { aceptada: $('Entrada valida').first().json.datos.aceptar } } }];\nreturn [{ json: { estado: 404, cuerpo: { error: { codigo: 'NO_ENCONTRADO', mensaje: 'La invitación no existe en este curso.' } } } }];"
      },
      "id": "99206d06-ce7e-5e59-b6da-622823610ed3",
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.cuerpo === null ? '' : JSON.stringify($json.cuerpo) }}",
        "options": {
          "responseCode": "={{ $json.estado }}",
          "responseHeaders": {
