---
import CategoryMenu from '../../features/catalog/components/CategoryMenu';
---

<header class="sticky top-0 z-10 border-b border-slate-200/70 bg-white/80 backdrop-blur">
  <nav class="mx-auto flex min-h-16 max-w-5xl flex-wrap items-center justify-between gap-2 px-4 py-2" aria-label="Principal">
    <a href="/" class="flex items-center gap-2 font-semibold text-slate-900">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-sky-500 to-sky-700 text-sm font-bold text-white" aria-hidden="true">MS</span>
      Medical School
    </a>
    <div class="flex items-center gap-1">
      <CategoryMenu client:load transition:persist="menu-categorias" />
      <form action="/cursos" method="get" role="search" class="flex items-center gap-1">
        <label for="busqueda_cabecera" class="sr-only">Buscar cursos</label>
        <input id="busqueda_cabecera" name="q" type="search" placeholder="Buscar cursos" class="w-36 rounded-lg border border-slate-300 px-3 py-1.5 text-sm focus-visible:outline-2 focus-visible:outline-sky-600/40 sm:w-52" />
        <button type="submit" class="rounded-lg px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100">Buscar</button>
      </form>
    </div>
    <slot />
  </nav>
</header>
