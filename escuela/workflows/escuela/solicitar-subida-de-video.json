    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH nuevo AS (\n  INSERT INTO escuela.videos_clase (id, clase_id, estado, nombre_original, tipo_contenido, tamano_bytes, ruta_base)\n  VALUES ($5::bigint, $1::bigint, 'esperando_archivo', $2::text, $3::text, $4::bigint, $6::text)\n  ON CONFLICT DO NOTHING RETURNING id\n), clave AS (\n  INSERT INTO escuela.claves_video (video_id, clave) SELECT id, gen_random_bytes(16) FROM nuevo RETURNING video_id\n)\nSELECT EXISTS (SELECT 1 FROM nuevo) AS registrado;",
        "options": {
          "queryReplacement": "={{ [$('Acceso valido').first().json.datos.clase_id, $('Acceso valido').first().json.datos.nombre_archivo, $('Acceso valido').first().json.datos.tipo_contenido, $('Acceso valido').first().json.datos.tamano_bytes, $('Armar rutas').first().json.video_id, $('Armar rutas').first().json.ruta_base] }}"
        }
      },
      "id": "c67e8b21-cfad-54c1-b433-158ca1b615ee",
      "name": "Registrar video",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        4500,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const p = $('Armar rutas').first().json;\nif ($input.first().json.registrado) return [{ json: { estado: 201, cuerpo: { video_id: p.video_id, url_subida: $('Clasificar firma').first().json.url_subida, ruta: p.ruta_original } } }];\nreturn [{ json: { estado: 409, cuerpo: { error: { codigo: 'VIDEO_EN_PROCESO', mensaje: 'Esta clase ya tiene un video subiéndose o procesándose.' } } } }];"
      },
      "id": "440671e0-f3be-5a4f-8b28-64a67246f8e9",
