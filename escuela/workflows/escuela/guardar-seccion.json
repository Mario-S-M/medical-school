    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH nueva AS (\n  INSERT INTO escuela.secciones (curso_id, titulo, posicion)\n  SELECT $1::bigint, $3::text, coalesce((SELECT max(posicion) FROM escuela.secciones WHERE curso_id = $1::bigint), 0) + 1\n  WHERE $2::bigint IS NULL RETURNING id\n), editada AS (\n  UPDATE escuela.secciones SET titulo = $3::text WHERE id = $2::bigint AND curso_id = $1::bigint RETURNING id\n)\nSELECT coalesce((SELECT id FROM nueva), (SELECT id FROM editada)) AS id;",
        "options": {
          "queryReplacement": "={{ [$json.datos.curso_id, $json.datos.seccion_id, $json.datos.titulo] }}"
        }
      },
      "id": "7c909e0d-7c4a-5171-bbef-42f11d60d8bd",
