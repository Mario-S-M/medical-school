    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst valida = new RegExp(`^cursos/${e.curso.id}/portada-[0-9a-f]{32}\\\\.(jpg|png|webp)$`).test(e.datos.ruta);\nif (!valida) return [{ json: { ok: false, estado: 422, cuerpo: { error: { codigo: 'PORTADA_INVALIDA', mensaje: 'La ruta de la portada no corresponde a este curso.' } } } }];\nreturn [{ json: { ok: true, ruta: e.datos.ruta } }];"
      },
      "id": "85cf3292-48a7-5f10-b14f-4e57ce5c91a3",
      "name": "Revisar ruta",
