    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH c AS (SELECT * FROM escuela.cursos WHERE id = $1::bigint),\nfaltas AS (\n  SELECT array_remove(ARRAY[\n    CASE WHEN coalesce(trim(c.subtitulo), '') = '' THEN 'falta_subtitulo' END,\n    CASE WHEN coalesce(trim(c.descripcion), '') = '' THEN 'falta_descripcion' END,\n    CASE WHEN c.nivel IS NULL THEN 'falta_nivel' END,\n    CASE WHEN c.categoria_id IS NULL THEN 'falta_categoria' END,\n    CASE WHEN c.portada_ruta IS NULL THEN 'falta_portada' END,\n    CASE WHEN NOT EXISTS (SELECT 1 FROM escuela.secciones s WHERE s.curso_id = c.id) THEN 'falta_secciones' END,\n    CASE WHEN EXISTS (SELECT 1 FROM escuela.secciones s WHERE s.curso_id = c.id\n                      AND NOT EXISTS (SELECT 1 FROM escuela.clases k WHERE k.seccion_id = s.id)) THEN 'seccion_vacia' END\n  ], NULL) AS lista FROM c\n), enviado AS (\n  UPDATE escuela.cursos SET estado = 'en_revision', comentario_revision = NULL, actualizado_en = now()\n  WHERE id = $1::bigint AND estado = 'borrador' AND cardinality((SELECT lista FROM faltas)) = 0 RETURNING id\n)\nSELECT (SELECT lista FROM faltas) AS faltas, (SELECT estado FROM c) AS estado, EXISTS (SELECT 1 FROM enviado) AS enviado;",
        "options": {
          "queryReplacement": "={{ [$json.datos.curso_id] }}"
        }
      },
      "id": "6222a729-22b1-52f8-86fe-a345f18b7dd5",
      "name": "Comprobar y enviar",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2400,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const MENSAJES = {\n  falta_subtitulo: 'Falta el subtítulo.', falta_descripcion: 'Falta la descripción.', falta_nivel: 'Falta elegir el nivel.',\n  falta_categoria: 'Falta elegir la categoría.', falta_portada: 'Falta la portada.', falta_secciones: 'El curso necesita al menos una sección.',\n  seccion_vacia: 'Hay secciones sin ninguna clase.' };\nconst r = $input.first().json;\nif (r.enviado) return [{ json: { estado: 200, cuerpo: { estado: 'en_revision' } } }];\nif (r.estado !== 'borrador') return [{ json: { estado: 409, cuerpo: { error: { codigo: 'ESTADO_INVALIDO', mensaje: 'Solo se pueden enviar a revisión los cursos en borrador.' } } } }];\nif (Array.isArray(r.faltas) && r.faltas.length) {\n  const detalles = r.faltas.map((regla) => ({ campo: 'curso', regla, mensaje: MENSAJES[regla] }));\n  return [{ json: { estado: 422, cuerpo: { error: { codigo: 'CURSO_INCOMPLETO', mensaje: 'Al curso le faltan datos para enviarlo a revisión.', detalles } } } }];\n}\nreturn [{ json: { estado: 500, cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];"
      },
      "id": "f113237f-d195-5097-8b66-30e5f680f612",
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
