[
  {
    "id": "autVerificar01",
    "name": "Verificar correo",
    "description": "POST /autenticacion/verificar-correo. Valida { correo, codigo }, aplica el bloqueo por códigos erróneos (5 por correo y 20 por IP cada 15 min), canjea el código de verificación en Supabase Auth (verify, tipo signup) y descarta la sesión que Supabase devuelve: solo confirma el correo, no abre sesión. No guarda ejecuciones.",
    "active": false,
    "isArchived": false,
    "settings": {
      "executionOrder": "v1",
      "saveDataErrorExecution": "none",
      "saveDataSuccessExecution": "none",
      "saveManualExecutions": false,
      "saveExecutionProgress": false,
      "executionTimeout": 15
    },
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "autenticacion/verificar-correo",
          "authentication": "headerAuth",
          "responseMode": "responseNode",
          "options": {}
        },
        "id": "a0000008-0000-4000-8000-000000000001",
        "name": "Recibir verificacion",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2.1,
        "position": [
          0,
          0
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "secretoProxy01",
