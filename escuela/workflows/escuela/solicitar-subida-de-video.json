    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.statusCode === 200 && r.body && r.body.url) return [{ json: { ok: true, url_subida: `/almacen${r.body.url}` } }];\nreturn [{ json: { ok: false, estado: 500, cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];"
      },
