          },
          "conditions": [
            {
              "id": "4fc83580-d1ec-5e4e-aeac-2f9fb809e267",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "68b9e045-be37-544d-9791-1f0efb4339ad",
      "name": "Entrada valida",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1500,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH c AS (SELECT id, estado FROM escuela.cursos WHERE id = $1::bigint),\nretirado AS (\n  UPDATE escuela.cursos SET estado = 'borrador', comentario_revision = $2::text, actualizado_en = now()\n  WHERE id = $1::bigint AND estado = 'publicado' RETURNING id\n)\nSELECT CASE WHEN NOT EXISTS (SELECT 1 FROM c) THEN 'no_encontrado'\n            WHEN EXISTS (SELECT 1 FROM retirado) THEN 'ok' ELSE 'estado_invalido' END AS resultado;",
        "options": {
          "queryReplacement": "={{ [$json.datos.curso_id, $json.datos.comentario] }}"
        }
      },
      "id": "57fd9e85-1396-5279-9507-71b7aedda5b2",
      "name": "Retirar del catalogo",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1800,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst error = (estado, codigo, mensaje) => [{ json: { estado, cuerpo: { error: { codigo, mensaje } } } }];\nif (r.resultado === 'ok') return [{ json: { estado: 200, cuerpo: { estado: 'borrador' } } }];\nif (r.resultado === 'no_encontrado') return error(404, 'NO_ENCONTRADO', 'El curso no existe.');\nif (r.resultado === 'estado_invalido') return error(409, 'ESTADO_INVALIDO', 'Solo se pueden retirar los cursos publicados.');\nreturn error(500, 'ERROR_INTERNO', 'Error interno del servidor.');"
      },
      "id": "3e6c5ed9-dc5d-54be-8ed4-c345313f8b7e",
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.cuerpo === null ? '' : JSON.stringify($json.cuerpo) }}",
        "options": {
          "responseCode": "={{ $json.estado }}",
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              },
              {
                "name": "X-Flujo",
                "value": "escuela"
              }
            ]
          }
        }
      },
      "id": "dd68f19e-82b5-5538-bde9-a840b09d6221",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        2400,
        0
      ]
    }
