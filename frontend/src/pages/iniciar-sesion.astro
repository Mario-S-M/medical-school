---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthCard from '../shared/layout/AuthCard.astro';
import LoginForm from '../features/auth/components/LoginForm';
---

<BaseLayout title="Iniciar sesión">
  <AuthCard title="Bienvenido de nuevo" description="Inicia sesión para continuar.">
    <LoginForm client:load />
    <p class="mt-5 text-center text-sm"><a class="text-sky-700 underline" href="/recuperar">¿Olvidaste tu contraseña?</a></p>
    <p class="mt-2 text-center text-sm text-slate-600">¿No tienes cuenta? <a class="text-sky-700 underline" href="/registro">Regístrate</a></p>
  </AuthCard>
</BaseLayout>
