        260,
        -260
      ]
    },
    {
      "parameters": {
        "content": "### Consultar Supabase Auth\nPregunta a `auth:9999/user` quién es el dueño del token. Un token vencido o falso da `401`.",
        "height": 430,
        "width": 780,
        "color": 1
      },
      "id": "68c264e7-f902-5ccc-aa73-378ccd8e9481",
      "name": "Nota Consultar Supabase Auth",
