    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH p AS (SELECT string_to_array($9::text, ',') AS presentes),\ncat AS (SELECT ($8::int IS NULL OR EXISTS (SELECT 1 FROM escuela.categorias WHERE id = $8::int)) AS ok),\nactualizado AS (\n  UPDATE escuela.cursos c SET\n    titulo = CASE WHEN 'titulo' = ANY(p.presentes) AND $2::text IS NOT NULL THEN $2::text ELSE c.titulo END,\n    subtitulo = CASE WHEN 'subtitulo' = ANY(p.presentes) THEN $3::text ELSE c.subtitulo END,\n    descripcion = CASE WHEN 'descripcion' = ANY(p.presentes) THEN $4::text ELSE c.descripcion END,\n    conocimientos_previos = CASE WHEN 'conocimientos_previos' = ANY(p.presentes) THEN $5::text ELSE c.conocimientos_previos END,\n    lo_que_aprenderas = CASE WHEN 'lo_que_aprenderas' = ANY(p.presentes) THEN ARRAY(SELECT jsonb_array_elements_text($6::jsonb)) ELSE c.lo_que_aprenderas END,\n    nivel = CASE WHEN 'nivel' = ANY(p.presentes) THEN $7::text ELSE c.nivel END,\n    categoria_id = CASE WHEN 'categoria_id' = ANY(p.presentes) THEN $8::int ELSE c.categoria_id END,\n    actualizado_en = now()\n  FROM p, cat WHERE c.id = $1::bigint AND cat.ok RETURNING c.id\n)\nSELECT CASE WHEN EXISTS (SELECT 1 FROM actualizado) THEN 'ok' WHEN NOT (SELECT ok FROM cat) THEN 'categoria_invalida' ELSE 'no_encontrado' END AS resultado;",
        "options": {
          "queryReplacement": "={{ [$json.datos.curso_id, $json.datos.titulo, $json.datos.subtitulo, $json.datos.descripcion, $json.datos.conocimientos_previos, JSON.stringify($json.datos.lo_que_aprenderas), $json.datos.nivel, $json.datos.categoria_id, $json.presentes.join(',')] }}"
        }
      },
      "id": "2ad74130-4ee5-5075-8439-e37885006747",
      "name": "Actualizar el curso",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2400,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst id = $('Acceso valido').first().json.curso.id;\nif (r.resultado === 'ok') return [{ json: { estado: 200, cuerpo: { id } } }];\nif (r.resultado === 'categoria_invalida') return [{ json: { estado: 422, cuerpo: { error: { codigo: 'VALIDACION_FALLIDA', mensaje: 'Revisa los datos enviados.', detalles: [{ campo: 'categoria_id', regla: 'categoria_inexistente', mensaje: 'La categoría no existe.' }] } } } }];\nif (r.resultado === 'no_encontrado') return [{ json: { estado: 404, cuerpo: { error: { codigo: 'NO_ENCONTRADO', mensaje: 'El curso no existe.' } } } }];\nreturn [{ json: { estado: 500, cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];"
      },
      "id": "fcb84bf0-f8df-5460-84ad-72343dc00691",
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
