    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "3fd8fd53-6436-5695-941d-b7805f3584c7",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c012fce8-70c5-5a39-be00-72b4bbe12110",
      "name": "Entrada valida",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT json_build_object(\n  'id', c.id, 'slug', c.slug, 'titulo', c.titulo, 'subtitulo', c.subtitulo, 'descripcion', c.descripcion,\n  'conocimientos_previos', c.conocimientos_previos, 'lo_que_aprenderas', c.lo_que_aprenderas, 'nivel', c.nivel,\n  'categoria', CASE WHEN cat.id IS NULL THEN NULL ELSE json_build_object('nombre', cat.nombre, 'slug', cat.slug) END,\n  'portada_ruta', c.portada_ruta, 'instructor', coalesce(i.nombre_publico, 'Instructor'), 'publicado_en', c.publicado_en,\n  'secciones', coalesce((\n    SELECT json_agg(json_build_object('id', s.id, 'titulo', s.titulo, 'posicion', s.posicion, 'clases', coalesce((\n      SELECT json_agg(json_build_object('id', k.id, 'titulo', k.titulo, 'descripcion', k.descripcion,\n             'duracion_estimada_minutos', k.duracion_estimada_minutos, 'es_muestra', k.es_muestra, 'posicion', k.posicion) ORDER BY k.posicion)\n      FROM escuela.clases k WHERE k.seccion_id = s.id), '[]'::json)) ORDER BY s.posicion)\n    FROM escuela.secciones s WHERE s.curso_id = c.id), '[]'::json)) AS curso\nFROM escuela.cursos c\nLEFT JOIN escuela.categorias cat ON cat.id = c.categoria_id\nLEFT JOIN escuela.perfiles_instructor i ON i.usuario_id = c.instructor_id\nWHERE c.slug = $1::text AND c.estado = 'publicado';",
        "options": {
          "queryReplacement": "={{ [$json.datos.slug] }}"
        }
      },
      "id": "d26f9e99-d1eb-5689-98c9-dd3ee06b3695",
      "name": "Consultar la ficha",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1200,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.curso) return [{ json: { estado: 200, cuerpo: r.curso } }];\nreturn [{ json: { estado: 404, cuerpo: { error: { codigo: 'NO_ENCONTRADO', mensaje: 'El curso no existe.' } } } }];"
      },
      "id": "ad4fd9b7-b913-5eac-b5cd-4dd511e57d3c",
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
