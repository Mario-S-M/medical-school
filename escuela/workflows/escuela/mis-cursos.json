          "conditions": [
            {
              "id": "0cf2db18-66b1-5f99-8b53-d794d1264db3",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
