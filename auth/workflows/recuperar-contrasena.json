[
  {
    "id": "autRecuperar01",
    "name": "Recuperar contrasena",
    "description": "POST /autenticacion/recuperar. Valida el correo, aplica el límite de solicitudes (3 por correo y 10 por IP cada hora), responde 202 de inmediato y después pide el código a Supabase Auth (auth:9999/recover); la respuesta es igual exista o no el correo. No guarda ejecuciones.",
    "active": false,
    "isArchived": false,
    "settings": {
      "executionOrder": "v1",
      "saveDataErrorExecution": "none",
      "saveDataSuccessExecution": "none",
      "saveManualExecutions": false,
      "saveExecutionProgress": false,
      "executionTimeout": 15
    },
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "autenticacion/recuperar",
          "authentication": "headerAuth",
          "responseMode": "responseNode",
          "options": {}
        },
        "id": "a0000006-0000-4000-8000-000000000001",
        "name": "Recibir recuperacion",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2.1,
        "position": [
          0,
          0
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "secretoProxy01",
            "name": "Secreto proxy"
          }
        },
        "webhookId": "a8f05264-0534-5f59-a129-e769768382d5"
      },
      {
        "parameters": {
          "jsCode": "const entrada = $input.first().json;\nconst cuerpo = entrada.body;\nconst falla = (detalles) => ({\n  ok: false, estado: 422,\n  cuerpo: { error: { codigo: 'VALIDACION_FALLIDA', mensaje: 'La solicitud no es válida.', detalles } },\n});\nif (cuerpo === null || typeof cuerpo !== 'object' || Array.isArray(cuerpo)) {\n  return [{ json: falla([{ campo: 'cuerpo', regla: 'debe_ser_objeto', mensaje: 'El cuerpo debe ser un objeto JSON.' }]) }];\n}\nconst detalles = [];\nfor (const clave of Object.keys(cuerpo)) {\n  if (clave !== 'correo') detalles.push({ campo: clave.slice(0, 40), regla: 'campo_no_permitido', mensaje: 'Este campo no está permitido.' });\n}\nif (!('correo' in cuerpo)) detalles.push({ campo: 'correo', regla: 'obligatorio', mensaje: 'Este campo es obligatorio.' });\nelse if (typeof cuerpo.correo !== 'string') detalles.push({ campo: 'correo', regla: 'debe_ser_texto', mensaje: 'Debe ser un texto.' });\nconst correo = typeof cuerpo.correo === 'string' ? cuerpo.correo.trim().toLowerCase() : '';\nif (typeof cuerpo.correo === 'string') {\n  const formato = /^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$/;\n  const local = correo.split('@')[0] || '';\n  if (correo.length === 0 || correo.length > 254 || local.length > 64 || !formato.test(correo)) {\n    detalles.push({ campo: 'correo', regla: 'formato_invalido', mensaje: 'Debe ser un correo válido de hasta 254 caracteres.' });\n  }\n}\nif (detalles.length > 0) return [{ json: falla(detalles) }];\nconst ipCruda = String(entrada.headers['x-ip-cliente'] || '');\nconst ip = /^[0-9a-fA-F:.]{2,45}$/.test(ipCruda) && (ipCruda.includes('.') || ipCruda.includes(':')) ? ipCruda : '0.0.0.0';\nreturn [{ json: { ok: true, correo, ip } }];"
        },
        "id": "a0000006-0000-4000-8000-000000000002",
        "name": "Validar solicitud",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          240,
