        "id": "a0000003-0000-4000-8000-000000000004",
        "name": "Canjear en Supabase Auth",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          720,
          -100
        ],
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "const r = $input.first().json;\nconst estado = r.statusCode;\nconst gt = r.body && typeof r.body === 'object' ? r.body : {};\nconst BORRAR = 'token_renovacion=; HttpOnly; SameSite=Strict; Path=/autenticacion; Max-Age=0';\nif (estado === 200 && gt.access_token && gt.refresh_token && gt.user) {\n  return [{ json: { estado: 200,\n    cookie: `token_renovacion=${gt.refresh_token}; HttpOnly; SameSite=Strict; Path=/autenticacion; Max-Age=604800`,\n    cuerpo: { token_acceso: gt.access_token, tipo_token: 'Bearer', expira_en: gt.expires_in,\n      usuario: { id: gt.user.id, correo: gt.user.email, nombre: (gt.user.user_metadata || {}).nombre ?? null } } } }];\n}\nif ([400, 401, 403, 404, 422].includes(estado)) {\n  return [{ json: { estado: 401, cookie: BORRAR,\n    cuerpo: { error: { codigo: 'TOKEN_INVALIDO', mensaje: 'La sesión no es válida o expiró. Inicia sesión de nuevo.' } } } }];\n}\nif (estado === 429) {\n  return [{ json: { estado: 429,\n    cuerpo: { error: { codigo: 'DEMASIADOS_INTENTOS', mensaje: 'Demasiadas solicitudes. Inténtalo más tarde.' } } } }];\n}\nreturn [{ json: { estado: 500,\n  cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];"
        },
