      "id": "a5bb7a31-8dcd-5bbd-a274-271180f789b4",
      "name": "Entrada valida",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1500,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  coalesce((SELECT json_agg(json_build_object('miembro_id', e.miembro_id, 'desde', e.creado_en,\n      'correo', (SELECT i.correo FROM escuela.invitaciones_equipo i WHERE i.instructor_id = e.instructor_id AND i.miembro_id = e.miembro_id AND i.estado = 'aceptada' ORDER BY i.respondida_en DESC LIMIT 1)) ORDER BY e.creado_en)\n    FROM escuela.equipos_apoyo e WHERE e.instructor_id = $1::uuid), '[]'::json) AS miembros,\n  coalesce((SELECT json_agg(json_build_object('id', i.id, 'correo', i.correo, 'expira_en', i.expira_en) ORDER BY i.creado_en DESC)\n    FROM escuela.invitaciones_equipo i WHERE i.instructor_id = $1::uuid AND i.estado = 'pendiente' AND i.expira_en >= now()), '[]'::json) AS invitaciones;",
        "options": {
          "queryReplacement": "={{ [$json.usuario.id] }}"
        }
      },
      "id": "a8d7d4a6-54c6-5465-b347-59ef4ef1e00f",
      "name": "Consultar equipo",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1800,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nreturn [{ json: { estado: 200, cuerpo: { miembros: r.miembros, invitaciones: r.invitaciones } } }];"
      },
      "id": "1622a46b-e088-573e-af1e-f032efd20bb1",
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        0
      ]
    },
    {
