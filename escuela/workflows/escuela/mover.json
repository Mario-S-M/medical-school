      "id": "8cc67ae3-ad62-558a-bb95-60ad8ea1cae8",
      "name": "Acceso valido",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2100,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH s_act AS (\n  SELECT id, curso_id, posicion FROM escuela.secciones WHERE $1::text = 'seccion' AND id = $2::bigint\n), s_vec AS (\n  SELECT x.id, x.posicion FROM escuela.secciones x JOIN s_act a ON x.curso_id = a.curso_id AND x.posicion = a.posicion + $3::int\n), s_mov AS (\n  UPDATE escuela.secciones x SET posicion = CASE WHEN x.id = (SELECT id FROM s_act) THEN (SELECT posicion FROM s_vec) ELSE (SELECT posicion FROM s_act) END\n  WHERE x.id IN ((SELECT id FROM s_act), (SELECT id FROM s_vec)) AND EXISTS (SELECT 1 FROM s_vec) RETURNING 1\n), c_act AS (\n  SELECT id, seccion_id, posicion FROM escuela.clases WHERE $1::text = 'clase' AND id = $2::bigint\n), c_vec AS (\n  SELECT x.id, x.posicion FROM escuela.clases x JOIN c_act a ON x.seccion_id = a.seccion_id AND x.posicion = a.posicion + $3::int\n), c_mov AS (\n  UPDATE escuela.clases x SET posicion = CASE WHEN x.id = (SELECT id FROM c_act) THEN (SELECT posicion FROM c_vec) ELSE (SELECT posicion FROM c_act) END\n  WHERE x.id IN ((SELECT id FROM c_act), (SELECT id FROM c_vec)) AND EXISTS (SELECT 1 FROM c_vec) RETURNING 1\n)\nSELECT CASE WHEN NOT EXISTS (SELECT 1 FROM s_act UNION ALL SELECT 1 FROM c_act) THEN 'no_encontrado'\n            WHEN EXISTS (SELECT 1 FROM s_mov UNION ALL SELECT 1 FROM c_mov) THEN 'movido' ELSE 'sin_cambio' END AS resultado;",
        "options": {
          "queryReplacement": "={{ [$json.datos.tipo, $json.datos.id, $json.datos.direccion === 'subir' ? -1 : 1] }}"
        }
      },
      "id": "4c053ab9-d11b-55f4-891c-af4100cf4a18",
      "name": "Intercambiar posiciones",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2400,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.resultado === 'movido' || r.resultado === 'sin_cambio') return [{ json: { estado: 200, cuerpo: { movido: r.resultado === 'movido' } } }];\nreturn [{ json: { estado: 404, cuerpo: { error: { codigo: 'NO_ENCONTRADO', mensaje: 'El elemento no existe en este curso.' } } } }];"
      },
      "id": "b8c40891-c33b-5412-b7e3-ca1674958fae",
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2700,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.cuerpo === null ? '' : JSON.stringify($json.cuerpo) }}",
        "options": {
          "responseCode": "={{ $json.estado }}",
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              },
              {
                "name": "X-Flujo",
                "value": "escuela"
              }
            ]
          }
        }
      },
      "id": "964f2f93-058c-5f1f-b8ff-a99c1bd12680",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
