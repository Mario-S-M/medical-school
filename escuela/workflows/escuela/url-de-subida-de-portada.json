        }
      },
      "webhookId": "397773ac-e61b-5d0e-8ca1-1acc03a95597"
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nreturn [{ json: { headers: e.headers, rol_requerido: \"instructor\", datos: e.body, reglas: {\"curso_id\": {\"tipo\": \"entero\", \"minimo\": 1, \"maximo\": 9007199254740}, \"tipo_contenido\": {\"tipo\": \"texto\", \"minimo\": 1, \"maximo\": 100}, \"tamano_bytes\": {\"tipo\": \"entero\", \"minimo\": 1, \"maximo\": 1000000000}}, acceso: {\"modo\": \"dueno\", \"editable\": true, \"tipo\": \"curso\", \"campo\": \"curso_id\"} } }];"
      },
