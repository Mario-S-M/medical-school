---
import '../estilos/global.css';
import Cabecera from '../componentes/estructura/Cabecera.astro';
import Pie from '../componentes/estructura/Pie.astro';

interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo} · Medical School</title>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900">
    <Cabecera />
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-10">
      <slot />
    </main>
    <Pie />
  </body>
</html>
