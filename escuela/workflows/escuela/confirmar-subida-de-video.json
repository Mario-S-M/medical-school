        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const v = $input.first().json;\nconst EXT = {\"video/mp4\": \"mp4\", \"video/quicktime\": \"mov\", \"video/webm\": \"webm\"};\nconst error = (estado, codigo, mensaje) => [{ json: { ok: false, estado, cuerpo: { error: { codigo, mensaje } } } }];\nif (!v.id) return error(404, 'NO_ENCONTRADO', 'El video no existe.');\nif (v.estado !== 'esperando_archivo') return error(409, 'ESTADO_INVALIDO', 'Este video ya se confirmó.');\nreturn [{ json: { ok: true, video_id: Number(v.id), tipo_contenido: v.tipo_contenido, tamano_bytes: Number(v.tamano_bytes), ruta_base: v.ruta_base, ruta_original: `${v.ruta_base}/original.${EXT[v.tipo_contenido]}`, clave_hex: v.clave_hex } }];"
      },
      "id": "bed8158b-eb17-5141-807d-9e59db75b117",
      "name": "Revisar estado",
