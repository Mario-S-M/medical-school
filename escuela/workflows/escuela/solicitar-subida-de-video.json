      "id": "f74700a0-48ee-5bc6-9d2b-3913c67cb11b",
      "name": "Video valido",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2700,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT nextval(pg_get_serial_sequence('escuela.videos_clase', 'id')) AS id,\n       'cursos/' || s.curso_id || '/secciones/' || s.id || '/clases/' || k.id AS carpeta_clase\nFROM escuela.clases k JOIN escuela.secciones s ON s.id = k.seccion_id WHERE k.id = $1::bigint;",
        "options": {
          "queryReplacement": "={{ [$('Acceso valido').first().json.datos.clase_id] }}"
        }
      },
      "id": "c6e54112-c317-5577-8187-0b55c11fc8e1",
      "name": "Reservar ruta",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        3000,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (!r.id) return [{ json: { ok: false, estado: 404, cuerpo: { error: { codigo: 'NO_ENCONTRADO', mensaje: 'La clase no existe.' } } } }];\nconst base = `${r.carpeta_clase}/${r.id}`;\nreturn [{ json: { ok: true, video_id: Number(r.id), ruta_base: base, ruta_original: `${base}/original.${$('Revisar video').first().json.extension}` } }];"
      },
      "id": "7838d38e-04f4-55f7-9dd7-b4715feb6dd4",
      "name": "Armar rutas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
