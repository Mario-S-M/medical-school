      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "secretoProxy01",
          "name": "Secreto proxy"
        }
      },
      "webhookId": "ca901405-d927-59c9-998d-c8176110904d"
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nreturn [{ json: { headers: e.headers, rol_requerido: \"instructor\", datos: e.body, reglas: {\"curso_id\": {\"tipo\": \"entero\", \"minimo\": 1, \"maximo\": 9007199254740}, \"titulo\": {\"tipo\": \"texto\", \"opcional\": true, \"minimo\": 5, \"maximo\": 120, \"alfanumerico\": true}, \"subtitulo\": {\"tipo\": \"texto\", \"opcional\": true, \"maximo\": 200}, \"descripcion\": {\"tipo\": \"texto\", \"opcional\": true, \"maximo\": 5000, \"multilinea\": true}, \"conocimientos_previos\": {\"tipo\": \"texto\", \"opcional\": true, \"maximo\": 2000, \"multilinea\": true}, \"lo_que_aprenderas\": {\"tipo\": \"lista_texto\", \"opcional\": true, \"maximo_items\": 10, \"maximo\": 150}, \"nivel\": {\"tipo\": \"opcion\", \"opcional\": true, \"valores\": [\"basico\", \"intermedio\", \"avanzado\"]}, \"categoria_id\": {\"tipo\": \"entero\", \"opcional\": true, \"minimo\": 1, \"maximo\": 32000}}, acceso: {\"modo\": \"dueno\", \"editable\": true, \"tipo\": \"curso\", \"campo\": \"curso_id\"} } }];"
      },
