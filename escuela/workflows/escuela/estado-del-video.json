    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nreturn [{ json: { headers: e.headers, rol_requerido: [\"instructor\", \"equipo_apoyo\"], datos: e.query, reglas: {\"clase_id\": {\"tipo\": \"entero\", \"minimo\": 1, \"maximo\": 9007199254740}}, acceso: {\"modo\": \"dueno_o_equipo\", \"editable\": false, \"tipo\": \"clase\", \"campo\": \"clase_id\"} } }];"
      },
