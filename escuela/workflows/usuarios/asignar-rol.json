      "id": "f930e102-ea9b-5cbf-87e2-5548a90abdf8",
      "name": "Cuenta existe",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3000,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH quitar AS (\n  DELETE FROM escuela.roles_usuario WHERE usuario_id = $1::uuid AND rol = $2::text AND NOT $3::boolean RETURNING 1\n), poner AS (\n  INSERT INTO escuela.roles_usuario (usuario_id, rol, asignado_por) SELECT $1::uuid, $2::text, $4::uuid WHERE $3::boolean ON CONFLICT DO NOTHING RETURNING 1\n), perfil AS (\n  INSERT INTO escuela.perfiles_instructor (usuario_id, nombre_publico) SELECT $1::uuid, $5::text WHERE $3::boolean AND $2::text = 'instructor'\n  ON CONFLICT (usuario_id) DO UPDATE SET nombre_publico = EXCLUDED.nombre_publico, actualizado_en = now() RETURNING 1\n)\nSELECT 'ok' AS resultado;",
        "options": {
          "queryReplacement": "={{ [$json.datos.usuario_id, $json.datos.rol, $json.datos.activo, $json.quien, $json.nombre] }}"
        }
      },
      "id": "43fd2524-ca61-5146-8271-903395f1028a",
      "name": "Aplicar el rol",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
