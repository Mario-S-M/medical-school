        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "const r = $input.first().json;\nconst estado = r.statusCode;\nconst gt = r.body && typeof r.body === 'object' ? r.body : {};\nif (estado === 200 && gt.access_token && gt.refresh_token && gt.user) {\n  return [{ json: { registrar: true, exitoso: true, estado: 200,\n    cookie: `token_renovacion=${gt.refresh_token}; HttpOnly; SameSite=Strict; Path=/autenticacion; Max-Age=604800`,\n    cuerpo: { token_acceso: gt.access_token, tipo_token: 'Bearer', expira_en: gt.expires_in,\n      usuario: { id: gt.user.id, correo: gt.user.email, nombre: (gt.user.user_metadata || {}).nombre ?? null } } } }];\n}\nif ([400, 401, 422].includes(estado)) {\n  return [{ json: { registrar: true, exitoso: false, estado: 401,\n    cuerpo: { error: { codigo: 'CREDENCIALES_INVALIDAS', mensaje: 'Correo o contraseña incorrectos.' } } } }];\n}\nif (estado === 429) {\n  return [{ json: { registrar: false, exitoso: false, estado: 429,\n    cuerpo: { error: { codigo: 'DEMASIADOS_INTENTOS', mensaje: 'Demasiadas solicitudes. Inténtalo más tarde.' } } } }];\n}\nreturn [{ json: { registrar: false, exitoso: false, estado: 500,\n  cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];"
        },
