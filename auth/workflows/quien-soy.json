        "id": "a0000004-0000-4000-8000-000000000004",
        "name": "Consultar usuario en Supabase Auth",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          720,
          -100
        ],
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "const r = $input.first().json;\nconst estado = r.statusCode;\nconst gt = r.body && typeof r.body === 'object' ? r.body : {};\nif (estado === 200 && gt.id) {\n  return [{ json: { estado: 200, cuerpo: { id: gt.id, correo: gt.email, nombre: (gt.user_metadata || {}).nombre ?? null } } }];\n}\nif ([400, 401, 403, 404].includes(estado)) {\n  return [{ json: { estado: 401, cuerpo: { error: { codigo: 'TOKEN_INVALIDO', mensaje: 'El token de acceso falta, no es válido o expiró.' } } } }];\n}\nif (estado === 429) {\n  return [{ json: { estado: 429, cuerpo: { error: { codigo: 'DEMASIADOS_INTENTOS', mensaje: 'Demasiadas solicitudes. Inténtalo más tarde.' } } } }];\n}\nreturn [{ json: { estado: 500, cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];"
        },
