    {
      "parameters": {
        "jsCode": "const r = $('Borrar y renumerar').first().json;\nif (r.borrada) return [{ json: { estado: 204, cuerpo: null } }];\nreturn [{ json: { estado: 404, cuerpo: { error: { codigo: 'NO_ENCONTRADO', mensaje: 'La sección no existe en este curso.' } } } }];"
      },
      "id": "baf1014c-e25b-59d3-ba61-41bbe7bbb0f3",
      "name": "Armar respuesta",
