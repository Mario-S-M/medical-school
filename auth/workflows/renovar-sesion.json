[
  {
    "id": "autRenovarSesion01",
    "name": "Renovar sesion",
    "description": "POST /autenticacion/renovar. Lee la cookie token_renovacion, la canjea en Supabase Auth (auth:9999/token?grant_type=refresh_token) y devuelve un token_acceso nuevo con la cookie rotada; si el token no sirve responde 401 y borra la cookie. No guarda ejecuciones.",
    "active": false,
    "isArchived": false,
    "settings": {
      "executionOrder": "v1",
      "saveDataErrorExecution": "none",
      "saveDataSuccessExecution": "none",
      "saveManualExecutions": false,
      "saveExecutionProgress": false,
      "executionTimeout": 15
    },
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "autenticacion/renovar",
          "authentication": "headerAuth",
          "responseMode": "responseNode",
          "options": {}
        },
        "id": "a0000003-0000-4000-8000-000000000001",
        "name": "Recibir renovacion",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2.1,
        "position": [
          0,
          0
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "secretoProxy01",
            "name": "Secreto proxy"
          }
        },
        "webhookId": "0951c8fe-ea13-59d0-baa4-d02769d57cb4"
      },
      {
        "parameters": {
          "jsCode": "const entrada = $input.first().json;\nconst cabecera = String(entrada.headers['cookie'] || '');\nlet token = '';\nfor (const par of cabecera.split(';')) {\n  const [nombre, ...resto] = par.trim().split('=');\n  if (nombre === 'token_renovacion') token = resto.join('=');\n}\nif (!/^[A-Za-z0-9_-]{8,128}$/.test(token)) {\n  return [{ json: { ok: false, estado: 401,\n    cuerpo: { error: { codigo: 'TOKEN_INVALIDO', mensaje: 'La sesión no es válida o expiró. Inicia sesión de nuevo.' } } } }];\n}\nreturn [{ json: { ok: true, token } }];"
        },
        "id": "a0000003-0000-4000-8000-000000000002",
        "name": "Extraer token de la cookie",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          240,
          0
        ]
      },
