    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE escuela.invitaciones_equipo SET estado = 'cancelada', respondida_en = now() WHERE instructor_id = $1::uuid AND miembro_id = $2::uuid AND estado = 'pendiente' AND expira_en < now() RETURNING id;",
        "options": {
          "queryReplacement": "={{ [$('Entrada valida').first().json.usuario.id, $json.miembro_id] }}"
        }
      },
      "id": "7be23a04-dda4-54fc-a888-904aa80e0641",
      "name": "Cerrar invitaciones caducadas",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2700,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH miembro AS (SELECT 1 FROM escuela.equipos_apoyo WHERE instructor_id = $1::uuid AND miembro_id = $2::uuid),\nvigente AS (SELECT 1 FROM escuela.invitaciones_equipo WHERE instructor_id = $1::uuid AND miembro_id = $2::uuid AND estado = 'pendiente' AND expira_en >= now()),\nnueva AS (\n  INSERT INTO escuela.invitaciones_equipo (instructor_id, miembro_id, correo)\n  SELECT $1::uuid, $2::uuid, $3::text WHERE NOT EXISTS (SELECT 1 FROM miembro) AND NOT EXISTS (SELECT 1 FROM vigente) RETURNING id, expira_en\n)\nSELECT CASE WHEN EXISTS (SELECT 1 FROM miembro) THEN 'ya_es_miembro' WHEN EXISTS (SELECT 1 FROM vigente) THEN 'duplicada' ELSE 'ok' END AS resultado,\n       (SELECT id FROM nueva) AS id, (SELECT expira_en FROM nueva) AS expira_en,\n       coalesce((SELECT nombre_publico FROM escuela.perfiles_instructor WHERE usuario_id = $1::uuid), 'Un instructor') AS instructor;",
        "options": {
          "queryReplacement": "={{ [$('Entrada valida').first().json.usuario.id, $('Revisar invitado').first().json.miembro_id, $('Revisar invitado').first().json.correo] }}"
        }
      },
      "id": "03e0b35f-e542-51df-aaaf-5d2476c1deff",
      "name": "Crear la invitacion",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        3000,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst error = (estado, codigo, mensaje) => [{ json: { ok: false, estado, cuerpo: { error: { codigo, mensaje } } } }];\nif (r.resultado === 'ya_es_miembro') return error(409, 'YA_ES_MIEMBRO', 'Esa persona ya está en tu equipo.');\nif (r.resultado === 'duplicada') return error(409, 'INVITACION_DUPLICADA', 'Ya hay una invitación pendiente para esa persona.');\nif (r.resultado !== 'ok') return error(500, 'ERROR_INTERNO', 'Error interno del servidor.');\nreturn [{ json: { ok: true, id: Number(r.id), expira_en: r.expira_en, instructor: r.instructor } }];"
      },
