# Copia este archivo a .env y rellena los valores con secretos generados con openssl.
# Ejemplos:
#   usuario:     n8n_$(openssl rand -hex 4)
#   contraseña:  openssl rand -base64 96 | tr -dc 'A-Za-z0-9' | head -c 32
#   clave n8n:   openssl rand -hex 32
#
# Postgres solo aplica usuario y contraseña al inicializar ./postgres vacía:
# si cambias estos valores, vacía esa carpeta antes de levantar el stack.

# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# n8n
# AVISO: cambiar N8N_ENCRYPTION_KEY invalida las credenciales ya guardadas en n8n.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=America/Mexico_City

# pgAdmin
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
