---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<section class="mx-auto w-full max-w-md rounded-2xl border border-slate-200 bg-white p-8 shadow-xl shadow-sky-900/5">
  <div class="mb-6 text-center">
    <span class="mx-auto mb-4 grid h-12 w-12 place-items-center rounded-full bg-sky-100 text-xl text-sky-700" aria-hidden="true">✚</span>
    <h1 class="text-2xl font-bold tracking-tight">{title}</h1>
    {description && <p class="mt-2 text-sm text-slate-600">{description}</p>}
  </div>
  <slot />
</section>
