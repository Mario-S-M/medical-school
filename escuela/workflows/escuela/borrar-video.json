      "parameters": {
        "operation": "executeQuery",
        "query": "WITH borrados AS (DELETE FROM escuela.videos_clase WHERE clase_id = $1::bigint RETURNING ruta_base) SELECT coalesce(array_agg(ruta_base), '{}') AS rutas_base, count(*)::int AS cantidad FROM borrados;",
        "options": {
          "queryReplacement": "={{ [$json.datos.clase_id] }}"
        }
      },
