      ]
    },
    {
      "parameters": {
        "content": "### Salida con error\nCualquier fallo termina aquí y se devuelve tal cual al workflow que llamó.",
        "height": 430,
        "width": 240,
        "color": 3
      },
      "id": "fdd9ab5e-0516-5ee5-bce5-8eb0f4b12448",
      "name": "Nota Salida con error",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1730,
        40
      ]
    },
    {
      "parameters": {
        "content": "### Validar sesion y roles\nSubworkflow compartido: **ningún workflow protegido repite esta lógica**, todos lo llaman con *Execute Workflow* y le pasan la solicitud del webhook.\n\nSalida: `{ ok, usuario, roles, equipos }` o `{ ok: false, estado, cuerpo }`.",
        "height": 150,
        "width": 1000,
        "color": 7
      },
      "id": "15c62343-53b9-5290-98b7-91e84b97825f",
      "name": "Nota Validar sesion y roles",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -650
      ]
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "8cd89494-2b91-525b-94c6-1a266aae5c40",
      "name": "Disparador",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const cabecera = String(($input.first().json.headers || {})['authorization'] || '');\nconst coincide = /^Bearer ([A-Za-z0-9_-]{10,2048}\\.[A-Za-z0-9_-]{10,2048}\\.[A-Za-z0-9_-]{10,2048})$/.exec(cabecera);\nif (!coincide) return [{ json: { ok: false, estado: 401, cuerpo: { error: { codigo: 'TOKEN_INVALIDO', mensaje: 'El token de acceso falta, no es válido o expiró.' } } } }];\nreturn [{ json: { ok: true, autorizacion: `Bearer ${coincide[1]}` } }];"
      },
      "id": "d4090e23-5561-5462-b381-494d9c935ce3",
      "name": "Extraer token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "6c780aa5-a00b-56d9-bdf6-5ee7a29cf5f9",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b3b5e496-ba81-5a7a-87ba-b72e5607ea4d",
      "name": "Hay token",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://auth:9999/user",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $json.autorizacion }}"
            }
          ]
        }
      },
      "id": "9a1b6120-951e-5f44-b678-4c470a625147",
      "name": "Consultar usuario en Supabase Auth",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        -100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst gt = r.body && typeof r.body === 'object' ? r.body : {};\nif (r.statusCode === 200 && gt.id) {\n  return [{ json: { ok: true, usuario: { id: gt.id, correo: gt.email, nombre: (gt.user_metadata || {}).nombre ?? null } } }];\n}\nif ([400, 401, 403, 404].includes(r.statusCode)) return [{ json: { ok: false, estado: 401, cuerpo: { error: { codigo: 'TOKEN_INVALIDO', mensaje: 'El token de acceso falta, no es válido o expiró.' } } } }];\nif (r.statusCode === 429) return [{ json: { ok: false, estado: 429, cuerpo: { error: { codigo: 'DEMASIADOS_INTENTOS', mensaje: 'Demasiadas solicitudes. Inténtalo más tarde.' } } } }];\nreturn [{ json: { ok: false, estado: 500, cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];"
      },
      "id": "07e1a041-b240-5569-a721-137cf7a11fa4",
      "name": "Clasificar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        -100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "29df6f96-7cb3-5888-877b-12433ad36f43",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "67c9f39e-28e4-5b7b-b422-f8e8927fc78e",
      "name": "Sesion valida",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1500,
        -100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  coalesce((SELECT array_agg(rol ORDER BY rol) FROM escuela.roles_usuario WHERE usuario_id = $1::uuid), '{}') AS roles,\n  coalesce((SELECT json_agg(json_build_object('instructor_id', e.instructor_id, 'nombre_publico', p.nombre_publico) ORDER BY e.creado_en)\n            FROM escuela.equipos_apoyo e LEFT JOIN escuela.perfiles_instructor p ON p.usuario_id = e.instructor_id\n            WHERE e.miembro_id = $1::uuid), '[]'::json) AS equipos;",
        "options": {
          "queryReplacement": "={{ [$json.usuario.id] }}"
        }
      },
      "id": "8df6d96e-fa83-5894-bab9-c40605a54cb6",
      "name": "Consultar roles y equipos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1800,
        -200
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const fila = $input.first().json;\nif (!Array.isArray(fila.roles)) return [{ json: { ok: false, estado: 500, cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];\nreturn [{ json: { ok: true, usuario: $('Clasificar respuesta').first().json.usuario, roles: fila.roles, equipos: fila.equipos || [] } }];"
      },
      "id": "5fd512f8-6ae9-51cc-a642-d3219c283ea6",
      "name": "Armar contexto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        -200
      ]
    },
    {
      "parameters": {},
      "id": "3100f0ff-a6a6-57e9-a61d-5e3049bfce61",
      "name": "Devolver error",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1800,
        300
      ]
    }
  ],
