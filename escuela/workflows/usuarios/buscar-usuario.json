    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nreturn [{ json: { headers: e.headers, rol_requerido: \"administrador\", datos: e.query, reglas: {\"correo\": {\"tipo\": \"correo\"}} } }];"
      },
