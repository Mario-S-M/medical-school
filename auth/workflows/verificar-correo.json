      {
        "parameters": {
          "jsCode": "const entrada = $input.first().json;\nconst cuerpo = entrada.body;\nconst falla = (detalles) => ({\n  ok: false, estado: 422,\n  cuerpo: { error: { codigo: 'VALIDACION_FALLIDA', mensaje: 'La solicitud no es válida.', detalles } },\n});\nif (cuerpo === null || typeof cuerpo !== 'object' || Array.isArray(cuerpo)) {\n  return [{ json: falla([{ campo: 'cuerpo', regla: 'debe_ser_objeto', mensaje: 'El cuerpo debe ser un objeto JSON.' }]) }];\n}\nconst ESPERADOS = ['correo', 'codigo'];\nconst detalles = [];\nfor (const clave of Object.keys(cuerpo)) {\n  if (!ESPERADOS.includes(clave)) detalles.push({ campo: clave.slice(0, 40), regla: 'campo_no_permitido', mensaje: 'Este campo no está permitido.' });\n}\nfor (const campo of ESPERADOS) {\n  if (!(campo in cuerpo)) detalles.push({ campo, regla: 'obligatorio', mensaje: 'Este campo es obligatorio.' });\n  else if (typeof cuerpo[campo] !== 'string') detalles.push({ campo, regla: 'debe_ser_texto', mensaje: 'Debe ser un texto.' });\n}\nconst correo = typeof cuerpo.correo === 'string' ? cuerpo.correo.trim().toLowerCase() : '';\nif (typeof cuerpo.correo === 'string') {\n  const formato = /^[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$/;\n  const local = correo.split('@')[0] || '';\n  if (correo.length === 0 || correo.length > 254 || local.length > 64 || !formato.test(correo)) {\n    detalles.push({ campo: 'correo', regla: 'formato_invalido', mensaje: 'Debe ser un correo válido de hasta 254 caracteres.' });\n  }\n}\nif (typeof cuerpo.codigo === 'string' && !/^[0-9]{6}$/.test(cuerpo.codigo)) {\n  detalles.push({ campo: 'codigo', regla: 'formato_invalido', mensaje: 'Debe ser un código de exactamente 6 dígitos.' });\n}\nif (detalles.length > 0) return [{ json: falla(detalles) }];\nconst ipCruda = String(entrada.headers['x-ip-cliente'] || '');\nconst ip = /^[0-9a-fA-F:.]{2,45}$/.test(ipCruda) && (ipCruda.includes('.') || ipCruda.includes(':')) ? ipCruda : '0.0.0.0';\nreturn [{ json: { ok: true, correo, ip, codigo: cuerpo.codigo } }];"
        },
