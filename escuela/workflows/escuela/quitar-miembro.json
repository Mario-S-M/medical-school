    {
      "parameters": {
        "httpMethod": "POST",
        "path": "escuela/quitar-miembro",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "5c2d61fa-f2ec-5686-afa8-02f109da2f10",
      "name": "Recibir solicitud",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "credentials": {
