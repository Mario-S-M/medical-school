    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT coalesce(json_agg(json_build_object('id', id, 'nombre', nombre, 'slug', slug, 'posicion', posicion) ORDER BY posicion, nombre), '[]'::json) AS categorias FROM escuela.categorias;",
        "options": {
          "queryReplacement": "={{ [] }}"
        }
      },
      "id": "3f7f3d63-723f-579f-a129-72cc1e4e3f84",
