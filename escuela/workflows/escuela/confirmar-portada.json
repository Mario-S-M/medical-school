      "typeVersion": 4.2,
      "position": [
        4200,
        0
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabaseServicio01",
          "name": "Supabase rol de servicio"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ruta = $('Revisar ruta').first().json.ruta;\nif (!$('Guardar portada').first().json.guardada) return [{ json: { estado: 404, cuerpo: { error: { codigo: 'NO_ENCONTRADO', mensaje: 'El curso no existe.' } } } }];\nreturn [{ json: { estado: 200, cuerpo: { portada_url: `/almacen/object/public/portadas/${ruta}` } } }];"
      },
      "id": "65d07385-3844-52a4-9d64-505dce3e07f0",
