{
  "id": "escUrlSubidaPortada01",
  "name": "URL de subida de portada",
  "description": "POST /escuela/url-subida-portada. Valida tipo y tamaño de la imagen y pide a Supabase Storage una URL firmada de un solo uso para que el navegador suba la portada directo (instructor dueño; no en revisión). No guarda ejecuciones.",
  "active": false,
  "isArchived": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false,
    "executionTimeout": 15
  },
  "nodes": [
    {
      "parameters": {
        "content": "### Entrada\nWebhook protegido por el secreto del proxy (Caddy es la única entrada).",
        "height": 430,
        "width": 240,
        "color": 4
      },
      "id": "8af979d6-2196-54d4-86bb-1717bb4f4a73",
