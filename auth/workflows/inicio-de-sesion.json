[
  {
    "id": "autInicioSesion01",
    "name": "Inicio de sesion",
    "description": "POST /autenticacion/iniciar-sesion. Valida, aplica bloqueo por correo (5 fallos/15 min) y por IP (20 fallos/15 min), autentica en Supabase Auth y devuelve token_acceso en el cuerpo y token_renovacion en cookie HttpOnly. No guarda ejecuciones.",
    "active": false,
    "isArchived": false,
    "settings": {
      "executionOrder": "v1",
      "saveDataErrorExecution": "none",
      "saveDataSuccessExecution": "none",
      "saveManualExecutions": false,
      "saveExecutionProgress": false,
      "executionTimeout": 15
    },
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
