        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "jsCode": "const r = $input.first().json;\nconst estado = r.statusCode;\nconst BORRAR = 'token_renovacion=; HttpOnly; SameSite=Strict; Path=/autenticacion; Max-Age=0';\nif (estado === 204 || estado === 200) return [{ json: { estado: 204, cookie: BORRAR } }];\nif ([400, 401, 403, 404].includes(estado)) {\n  return [{ json: { estado: 401, cookie: BORRAR,\n    cuerpo: { error: { codigo: 'TOKEN_INVALIDO', mensaje: 'El token de acceso falta, no es válido o expiró.' } } } }];\n}\nif (estado === 429) {\n  return [{ json: { estado: 429, cuerpo: { error: { codigo: 'DEMASIADOS_INTENTOS', mensaje: 'Demasiadas solicitudes. Inténtalo más tarde.' } } } }];\n}\nreturn [{ json: { estado: 500, cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];"
        },
