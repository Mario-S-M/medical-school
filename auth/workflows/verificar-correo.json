      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH limpieza AS (\n  DELETE FROM autenticacion.eventos_codigo WHERE creado_en < now() - interval '1 day'\n),\npor_correo AS (\n  SELECT count(*) AS n, min(creado_en) AS primero\n  FROM autenticacion.eventos_codigo\n  WHERE correo = $1 AND proposito = $4 AND tipo = 'error' AND creado_en > now() - interval '15 minutes'\n),\npor_ip AS (\n  SELECT count(*) AS n, min(creado_en) AS primero\n  FROM autenticacion.eventos_codigo\n  WHERE ip = $2::inet AND tipo = 'error' AND creado_en > now() - interval '15 minutes'\n),\ncomun AS (\n  SELECT EXISTS (SELECT 1 FROM autenticacion.contrasenas_comunes WHERE contrasena IN (SELECT jsonb_array_elements_text($3::jsonb))) AS es_comun\n)\nSELECT pc.n AS errores_correo,\n       GREATEST(1, CEIL(EXTRACT(EPOCH FROM (pc.primero + interval '15 minutes' - now()))))::int AS reintentar_correo,\n       pi.n AS errores_ip,\n       GREATEST(1, CEIL(EXTRACT(EPOCH FROM (pi.primero + interval '15 minutes' - now()))))::int AS reintentar_ip,\n       c.es_comun\nFROM por_correo pc, por_ip pi, comun c;",
          "options": {
            "queryReplacement": "={{ [$json.correo, $json.ip, '[]', 'verificacion'] }}"
          }
        },
        "id": "a0000008-0000-4000-8000-000000000004",
        "name": "Consultar limites",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.5,
        "position": [
          720,
          -150
        ],
        "credentials": {
          "postgres": {
            "id": "pgSupabase01",
            "name": "Postgres n8n (Supabase)"
          }
        },
        "onError": "continueRegularOutput",
        "alwaysOutputData": true
      },
      {
        "parameters": {
          "jsCode": "const c = $input.first().json;\nif (c.error || c.errores_correo === undefined) {\n  return [{ json: { ruta: 'respuesta', estado: 500, cuerpo: { error: { codigo: 'ERROR_INTERNO', mensaje: 'Error interno del servidor.' } } } }];\n}\nif (Number(c.errores_correo) >= 5) {\n  const s = Number(c.reintentar_correo);\n  return [{ json: { ruta: 'bloqueo', estado: 429, retry_after: s, cuerpo: { error: {\n    codigo: 'CODIGO_BLOQUEADO', mensaje: 'Demasiados códigos erróneos. Inténtalo de nuevo más tarde.', reintentar_en_segundos: s } } } }];\n}\nif (Number(c.errores_ip) >= 20) {\n  const s = Number(c.reintentar_ip);\n  return [{ json: { ruta: 'bloqueo', estado: 429, retry_after: s, cuerpo: { error: {\n    codigo: 'DEMASIADOS_INTENTOS', mensaje: 'Demasiados intentos desde tu conexión. Inténtalo de nuevo más tarde.', reintentar_en_segundos: s } } } }];\n}\nreturn [{ json: { ruta: 'continuar' } }];"
        },
