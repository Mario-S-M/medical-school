              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              },
              {
                "name": "X-Flujo",
                "value": "escuela"
              }
            ]
          }
        }
      },
      "id": "a3fbbc03-0d0b-5f43-8b3d-6c740c7eef74",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
