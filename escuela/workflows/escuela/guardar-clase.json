    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.id) return [{ json: { estado: 200, cuerpo: { id: Number(r.id) } } }];\nreturn [{ json: { estado: 404, cuerpo: { error: { codigo: 'NO_ENCONTRADO', mensaje: 'La clase no existe en este curso.' } } } }];"
      },
      "id": "464fe73a-1258-5e8f-ad25-e70cd7ba89cb",
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
