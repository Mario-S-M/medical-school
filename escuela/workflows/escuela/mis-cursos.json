      "id": "ff10451b-16c1-5c5f-93f4-20bfe5bd8e31",
      "name": "Entrada valida",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1500,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT coalesce(json_agg(t ORDER BY t.actualizado_en DESC), '[]'::json) AS cursos FROM (\n  SELECT c.id, c.slug, c.titulo, c.estado, c.comentario_revision, c.portada_ruta, c.actualizado_en,\n         (c.instructor_id = $1::uuid) AS es_mio, coalesce(p.nombre_publico, 'Instructor') AS instructor\n  FROM escuela.cursos c LEFT JOIN escuela.perfiles_instructor p ON p.usuario_id = c.instructor_id\n  WHERE c.instructor_id = $1::uuid\n     OR c.instructor_id IN (SELECT instructor_id FROM escuela.equipos_apoyo WHERE miembro_id = $1::uuid)\n) t;",
        "options": {
          "queryReplacement": "={{ [$json.usuario.id] }}"
        }
      },
      "id": "b2699e61-c036-52b3-aced-216902be39b4",
      "name": "Consultar cursos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1800,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { estado: 200, cuerpo: { cursos: $input.first().json.cursos } } }];"
      },
