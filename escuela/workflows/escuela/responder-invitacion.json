    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nreturn [{ json: { headers: e.headers, rol_requerido: \"cualquiera\", datos: e.body, reglas: {\"invitacion_id\": {\"tipo\": \"entero\", \"minimo\": 1, \"maximo\": 9007199254740}, \"aceptar\": {\"tipo\": \"booleano\"}} } }];"
      },
