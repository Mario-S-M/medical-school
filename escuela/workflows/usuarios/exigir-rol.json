    {
      "parameters": {
        "jsCode": "const contexto = $input.first().json;\nconst original = $('Disparador').first().json;\nconst requeridos = [].concat(original.rol_requerido);\nif (!requeridos.includes('cualquiera') && !requeridos.some((r) => contexto.roles.includes(r))) {\n  return [{ json: { ok: false, estado: 403, cuerpo: { error: { codigo: 'SIN_PERMISO', mensaje: 'No tienes permiso para hacer esto.' } } } }];\n}\nreturn [{ json: { ...original, ...contexto } }];"
      },
