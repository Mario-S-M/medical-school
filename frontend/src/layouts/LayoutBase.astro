---
import { ClientRouter } from 'astro:transitions';
import '../estilos/global.css';
import Cabecera from '../componentes/estructura/Cabecera.astro';
import MenuSesion from '../componentes/estructura/MenuSesion';
import Pie from '../componentes/estructura/Pie.astro';

interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo} · Medical School</title>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col bg-gradient-to-b from-sky-50 via-white to-slate-50 text-slate-900">
    <Cabecera><MenuSesion client:load transition:persist="menu-sesion" /></Cabecera>
    <main class="mx-auto flex w-full max-w-5xl flex-1 flex-col justify-center px-4 py-10">
      <slot />
    </main>
    <Pie />
  </body>
</html>
