              "version": 2
            },
            "conditions": [
              {
                "id": "ae82c7b5-1d43-55b9-a2a6-c8d7aa1df561",
                "leftValue": "={{ $json.ok }}",
                "rightValue": "",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
