      ]
    },
    {
      "parameters": {
        "content": "### Comprobar permiso\nExige el rol `instructor` con el subworkflow `Exigir rol`. Sin sesión da `401`; sin el rol, `403`.",
        "height": 430,
        "width": 780,
        "color": 1
      },
      "id": "7b0764b4-7440-5dc1-abea-34dddeadded7",
      "name": "Nota Comprobar permiso",
