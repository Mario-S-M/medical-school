      "id": "372514d4-f0af-564b-95b4-8ecd88564d34",
      "name": "Entrada valida",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1500,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH quitado AS (DELETE FROM escuela.equipos_apoyo WHERE instructor_id = $1::uuid AND miembro_id = $2::uuid RETURNING miembro_id),\nrol AS (\n  DELETE FROM escuela.roles_usuario WHERE usuario_id = $2::uuid AND rol = 'equipo_apoyo' AND EXISTS (SELECT 1 FROM quitado)\n    AND NOT EXISTS (SELECT 1 FROM escuela.equipos_apoyo WHERE miembro_id = $2::uuid AND instructor_id <> $1::uuid) RETURNING 1\n)\nSELECT EXISTS (SELECT 1 FROM quitado) AS quitado;",
        "options": {
          "queryReplacement": "={{ [$json.usuario.id, $json.datos.miembro_id] }}"
        }
      },
      "id": "66a730d3-41e9-5ac7-ba57-bae77d0c86a9",
      "name": "Quitar del equipo",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1800,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "pgSupabase01",
          "name": "Postgres n8n (Supabase)"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nif (r.quitado) return [{ json: { estado: 204, cuerpo: null } }];\nreturn [{ json: { estado: 404, cuerpo: { error: { codigo: 'NO_ENCONTRADO', mensaje: 'El miembro no existe en este curso.' } } } }];"
      },
      "id": "87eb2afb-ad6c-5bcd-b8c1-90eb67680757",
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        0
      ]
    },
    {
