    {
      "parameters": {
        "jsCode": "const dueno = $('Acceso valido').first().json.es_dueno;\nreturn [{ json: { estado: 200, cuerpo: { ...$input.first().json.curso, es_dueno: dueno } } }];"
      },
      "id": "636a233c-52ad-58c5-bcc1-8f6c9a2a14d9",
      "name": "Armar respuesta",
